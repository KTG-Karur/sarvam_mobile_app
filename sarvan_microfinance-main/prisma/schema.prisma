  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  fromBranch Branch @relation("FromBranch", fields: [fromBranchId], references: [id])
  toBranch   Branch @relation("ToBranch", fields: [toBranchId], references: [id])
  createdBy  User   @relation("CreatedBranchTransfers", fields: [createdById], references: [id])

  @@map("branch_transfers")
}

model LeaveType {
  id                          String                 @id @default(uuid())
  typeId                      Int                    @unique
  leaveType                   String                 @unique
  isActive                    Boolean                @default(true)
  /// Marks this as the system-referenced "Loss of Pay" type: excess-over-balance
  /// days on leave approval are stamped with it, and it is hidden from the
  /// employee-facing Apply Leave dropdown (never something an employee picks).
  isLop                       Boolean                @default(false)
  /// Proof / attachment rule — see attendance-hr/plan-leave-proof-attachment.md.
  /// null = never required; N = required when the application's numberOfDays is MORE THAN N
  /// (e.g. 2 => 3+ days need proof); 0 = always required.
  attachmentRequiredAboveDays Decimal?               @db.Decimal(5, 2)
  /// Whether unused remainingBalance from a closed month carries into the next
  /// month's openingBalance (capped at carryForwardMaxDays) instead of being
  /// forfeited — see attendance-hr/plan-leave-carry-forward.md. Rollover runs
  /// from app/api/payroll/salary-pay/route.ts once that month's payroll is
  /// marked PAID (this codebase's stand-in for "the month is locked/closed" —
  /// there is no separate attendance-lock cron).
  allowCarryForward           Boolean                @default(false)
  /// Max days of remainingBalance that can carry forward when allowCarryForward
  /// is true; anything beyond this is forfeited. Enforced as required (in the
  /// API) whenever allowCarryForward is true.
  carryForwardMaxDays         Decimal?               @db.Decimal(5, 2)
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
  leaveBalances               EmployeeLeaveBalance[]
  attendances                 Attendance[]
  leaveApplications           LeaveApplication[]

  @@map("leave_types")
}

/// Short-duration "permission" (gate-pass) categories — the hours-scale
/// counterpart to LeaveType.
model PermissionType {
  id                 String              @id @default(uuid())
  typeId             Int                 @unique
  permissionType     String              @unique
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  permissionRequests PermissionRequest[]

  @@map("permission_types")
}

/// Shift Management (HR Administration) — see attendance-hr/plan-shift-management.md.
/// A named work shift with its own start/end time. Employees are assigned via `User.shiftId`
/// (bulk-assign screen). Does not yet feed punch/attendance calculation — see the schema
/// comment on `User.shiftId`.
model Shift {
  id           String   @id @default(cuid())
  name         String   @unique
  shiftStart   String // "HH:MM"
  shiftEnd     String // "HH:MM"
  /// Worked hours >= this => PRESENT, else HALF_DAY (mirrors WorkingHoursConfig.fullDayHours,
  /// now per-shift — see app/lib/employee-shift.ts).
  fullDayHours Float    @default(8)
  halfDayHours Float    @default(0)
  graceMinutes Int      @default(15)
  /// The fallback shift for any employee with no shift assigned — see
  /// app/lib/employee-shift.ts. Only one shift may hold this at a time (same
  /// single-holder pattern as LeaveType.isLop).
  isDefault    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  employees    User[]
  onboardingRequests EmployeeOnboardingRequest[]

  @@map("shifts")
}

enum PermissionRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Short-duration "permission" (gate-pass) request — a few hours within a single
/// day. Apply/cancel/approve/reject flow mirrors LeaveApplication, but there is
/// no balance ledger: a permission is tracked and approved, not deducted from a
/// day allowance.
model PermissionRequest {
  id                 String                  @id @default(cuid())
  employeeId         String
  employee           User                    @relation("PermissionRequestOwner", fields: [employeeId], references: [id])
  permissionTypeId   String
  permissionType     PermissionType          @relation(fields: [permissionTypeId], references: [id])
  date               DateTime
  fromTime           String
  toTime             String
  hours              Decimal                 @db.Decimal(5, 2)
  reason             String?
  status             PermissionRequestStatus @default(PENDING)
  appliedAt          DateTime                @default(now())
  approvedById       String?
  approvedBy         User?                   @relation("PermissionRequestApprovedBy", fields: [approvedById], references: [id])
  approvedAt         DateTime?
  approvalRemarks    String?
  cancelledAt        DateTime?
  cancelledById      String?
  cancelledBy        User?                   @relation("PermissionRequestCancelledBy", fields: [cancelledById], references: [id])
  cancelReason       String?
  /// True if approving this request was the Nth in the employee's rolling
  /// permission-quota cycle and it forced `date`'s Attendance to ABSENT+LOP
  /// (see the Working Hours "Max Permissions per Cycle" setting). Lets
  /// admin-cancel know precisely whether — and how — to reverse that.
  triggeredLop       Boolean                 @default(false)
  approvalInstanceId String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([employeeId])
  @@index([approvalInstanceId])
  @@map("permission_requests")
}

/// One row per employee + leave type + calendar month, instead of a single
/// ever-overwritten row — see attendance-hr/plan-leave-carry-forward.md.
/// Real per-month history is what makes carry-forward possible: rollover
/// (app/lib/attendance-leave-permission.ts's rolloverLeaveBalancesForNextMonth)
/// reads the just-closed month's row to compute the next month's
/// carriedForwardDays, rather than overwriting in place.
model EmployeeLeaveBalance {
  id                 String    @id @default(cuid())
  employeeId         String
  leaveTypeId        String
  month              Int
  year               Int
  openingBalance     Decimal   @default(0) @db.Decimal(10, 2)
  /// Days folded in from the previous month's closing remainingBalance
  /// (capped at LeaveType.carryForwardMaxDays) — 0 when the leave type
  /// doesn't allow carry-forward, or this is the first month on record.
  carriedForwardDays Decimal   @default(0) @db.Decimal(10, 2)
  remainingBalance   Decimal   @default(0) @db.Decimal(10, 2)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  employee           User      @relation(fields: [employeeId], references: [id])
  leaveType          LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, month, year])
  @@map("employee_leave_balances")
}

enum LeaveApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Leave apply/cancel/approve/reject flow — a genuine gap prior to HR Phase 3
/// (only EmployeeLeaveBalance, an opening/remaining balance tally, existed).
/// Approval deducts numberOfDays from EmployeeLeaveBalance.remainingBalance
/// inside a re-fetch-and-recheck $transaction (same discipline as the
/// foreclosure approve route).
enum HalfDaySession {
  FIRST_HALF
  SECOND_HALF
}

model LeaveApplication {
  id                 String                       @id @default(cuid())
  employeeId         String
  employee           User                         @relation("LeaveApplicationOwner", fields: [employeeId], references: [id])
  leaveTypeId        String
  leaveType          LeaveType                    @relation(fields: [leaveTypeId], references: [id])
  fromDate           DateTime
  toDate             DateTime
  numberOfDays       Decimal                      @db.Decimal(5, 2)
  /// Single-date leave (fromDate = toDate) consuming 0.5 of the balance instead
  /// of a whole day — see attendance-hr/plan-half-day-leave.md. Only blocks
  /// punch-in during the corresponding half's time window (split at the shift
  /// midpoint), not the whole day.
  isHalfDay          Boolean                      @default(false)
  halfDaySession     HalfDaySession? // set only when isHalfDay = true
  reason             String?
  status             LeaveApplicationStatus       @default(PENDING)
  appliedAt          DateTime                     @default(now())
  approvedById       String?
  approvedBy         User?                        @relation("LeaveApplicationApprovedBy", fields: [approvedById], references: [id])
  approvedAt         DateTime?
  approvalRemarks    String?
  cancelledAt        DateTime?
  cancelledById      String?
  cancelledBy        User?                        @relation("LeaveApplicationCancelledBy", fields: [cancelledById], references: [id])
  cancelReason       String?
  approvalInstanceId String?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  attachments        LeaveApplicationAttachment[]

  @@index([employeeId])
  @@index([approvalInstanceId])
  @@map("leave_applications")
}

/// Proof (e.g. medical certificate) attached to a leave application. `fileKey` is the private
/// GCS object key — never returned to clients; read through the leave attachment view route.
model LeaveApplicationAttachment {
  id                 String           @id @default(cuid())
  leaveApplicationId String
  leaveApplication   LeaveApplication @relation(fields: [leaveApplicationId], references: [id], onDelete: Cascade)
  fileKey            String
  fileName           String
  mimeType           String
  fileSize           Int
  uploadedById       String
  createdAt          DateTime         @default(now())

  @@index([leaveApplicationId])
  @@map("leave_application_attachments")
}

enum SalaryComponentType {
  EARNINGS
  DEDUCTIONS
}

enum SalaryPercentBasis {
  BASIC
  GROSS
}

model SalaryComponent {
  staffLoanSalaryBasisSchemes StaffLoanScheme[]      @relation("StaffLoanSalaryBasis")
  id                          String                 @id @default(cuid())
  salaryId                    Int                    @unique
  name                        String                 @unique
  type                        SalaryComponentType
  isActive                    Boolean                @default(true)
  /// Org-wide default rate for a percentage-based deduction (e.g. PF 12%,
  /// ESI 0.75%) — null means this component stays a flat manually-entered
  /// amount, unchanged from before. Only meaningful with percentBasis set.
  defaultPercent              Decimal?               @db.Decimal(5, 2)
  /// What the percentage is computed against — BASIC (statutory PF pattern)
  /// or GROSS (statutory ESI pattern). Required together with defaultPercent.
  percentBasis                SalaryPercentBasis?
  /// Optional ceiling (₹/month) on the percentage-computed amount — e.g. PF
  /// capped at ₹1,800. Null = no cap, the computed percentage is used as-is.
  /// Only meaningful with defaultPercent set.
  maxAmount                   Decimal?               @db.Decimal(15, 2)
  /// Optional eligibility ceiling on the employee's Month CTC Pay — when the
  /// employee's CTC is above this, the percentage deduction is 0 (e.g. ESI
  /// only applies up to ₹21,000 CTC). Null = applies at any CTC.
  ctcEligibilityLimit         Decimal?               @db.Decimal(15, 2)
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
  salaryMasters               EmployeeSalaryMaster[]
  salaryPayItems              SalaryPayLineItem[]

  @@map("salary_components")
}

model EmployeeSalaryMaster {
  id                String          @id @default(cuid())
  employeeId        String
  salaryComponentId String
  amount            Decimal         @default(0) @db.Decimal(15, 2)
  /// Per-employee override of the component's defaultPercent (e.g. one
  /// employee negotiated a different PF rate, or is exempt at 0%). Null =
  /// use SalaryComponent.defaultPercent. Ignored for components that aren't
  /// percentage-based (defaultPercent null on the component).
  percentOverride   Decimal?        @db.Decimal(5, 2)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  employee          User            @relation(fields: [employeeId], references: [id])
  salaryComponent   SalaryComponent @relation(fields: [salaryComponentId], references: [id])

  @@unique([employeeId, salaryComponentId])
  @@map("employee_salary_masters")
}

/// One row per employee — the CTC figure that drives the Basic/HRA split
/// (Designation.basicPercent/hraPercent) on the redesigned Salary Master page.
/// Kept separate from EmployeeSalaryMaster (which is per-component) since CTC
/// is singular per employee, not a component amount itself.
model EmployeeCtcMaster {
  employeeId  String   @id
  monthlyCtc  Decimal  @db.Decimal(15, 2)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee  User  @relation(fields: [employeeId], references: [id])
  updatedBy User? @relation("EmployeeCtcMasterUpdatedBy", fields: [updatedById], references: [id])

  @@map("employee_ctc_masters")
}

enum CtcChangeSource {
  ONBOARDING
  MANUAL_EDIT
  PROMOTION
}

/// Append-only CTC change log — EmployeeCtcMaster itself is a single mutable
/// current-value row with no history, so this is the actual audit trail,
/// written alongside every EmployeeCtcMaster write regardless of source
/// (Onboarding finalize, a direct Organization-tab edit, or an approved
/// Promotion). Mirrors EmployeePromotion's from/to + effectiveDate shape.
model EmployeeCtcHistory {
  id             String             @id @default(cuid())
  employeeId     String
  employee       User               @relation(fields: [employeeId], references: [id])
  /// Null on the very first (Onboarding) entry — there is no prior CTC.
  fromMonthlyCtc Decimal?           @db.Decimal(15, 2)
  toMonthlyCtc   Decimal            @db.Decimal(15, 2)
  effectiveDate  DateTime           @db.Date
  source         CtcChangeSource
  promotionId    String?
  promotion      EmployeePromotion? @relation(fields: [promotionId], references: [id])
  remarks        String?
  changedById    String
  changedBy      User               @relation("EmployeeCtcHistoryChangedBy", fields: [changedById], references: [id])
  createdAt      DateTime           @default(now())

  @@index([employeeId, effectiveDate])
  @@map("employee_ctc_history")
}

enum SalaryPayStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
}

model SalaryPayRecord {
