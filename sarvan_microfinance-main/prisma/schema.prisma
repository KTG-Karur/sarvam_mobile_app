enum ClientApprovalStatus {
  DRAFT // FDO saved enrollment as draft — not yet submitted for review
  SUBMITTED // FDO submitted enrollment into approval queue
  PENDING_BM_REVIEW // Awaiting BM first-stage review
  BM_RETAKE_REQUIRED // BM sent back to FDO for corrections
  PENDING_AM_REVIEW // BM completed review, awaiting AM
  AM_RETAKE_REQUIRED // AM sent back for corrections
  PENDING_QC_VERIFICATION // AM approved — awaiting Background Verification Team
  QC_VERIFICATION_RETAKE_REQUIRED // QC team requested corrections from FDO
  PENDING_FINAL_REVIEW // QC verified — awaiting Admin final approval
  FINAL_RETAKE_REQUIRED // Admin sent back to FDO for corrections
  APPROVED // Admin gave final approval — client fully approved
  REJECTED // Rejected at BM, AM, QC, or Final stage
  // Dynamic workflow levels (used when ClientWorkflowConfig is active)
  PENDING_LEVEL_1
  LEVEL_1_RETAKE_REQUIRED
  PENDING_LEVEL_2
  LEVEL_2_RETAKE_REQUIRED
  PENDING_LEVEL_3
  LEVEL_3_RETAKE_REQUIRED
  PENDING_LEVEL_4
  LEVEL_4_RETAKE_REQUIRED
  PENDING_LEVEL_5
  LEVEL_5_RETAKE_REQUIRED
}

enum KYCStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

// CR-3: Per-document review decisions for BM and AM
enum KYCDocumentDecision {
  PENDING
  VERIFIED
  RETAKE_REQUIRED
  DELETED
  REJECTED
}

// CR-3: Audit trail action types
enum ApprovalAction {
  SUBMITTED // FDO submitted for review
  BM_VERIFIED_DOCUMENT // BM verified a KYC document
  BM_RETAKE_DOCUMENT // BM requested retake on a document
  BM_DELETED_DOCUMENT // BM deleted a document
  BM_REJECTED_DOCUMENT // BM rejected a document
  BM_COMPLETED_REVIEW // BM completed all reviews, forwarded to AM
  BM_REJECTED_CLIENT // BM rejected the client entirely
  AM_VERIFIED_DOCUMENT // AM verified a KYC document
  AM_RETAKE_DOCUMENT // AM requested retake on a document
  AM_DELETED_DOCUMENT // AM deleted a document
  AM_REJECTED_DOCUMENT // AM rejected a document
  AM_APPROVED_CLIENT // AM forwarded to QC verification
  AM_REJECTED_CLIENT // AM rejected the client
  QC_VERIFIED_CLIENT // QC team verified and forwarded to Admin final review
  QC_REJECTED_CLIENT // QC team rejected the client
  QC_RETAKE_CLIENT // QC team requested corrections from FDO
  QC_VERIFIED_DOCUMENT // QC verified a KYC document
  QC_RETAKE_DOCUMENT // QC requested retake on a document
  QC_REJECTED_DOCUMENT // QC rejected a document
  QC_DELETED_DOCUMENT // QC deleted a document
  FINAL_APPROVED_CLIENT // Branch Admin / HO Admin gave final approval
  FINAL_REJECTED_CLIENT // Branch Admin / HO Admin rejected the client
  FINAL_RETAKE_CLIENT // Branch Admin / HO Admin sent back for corrections
  FDO_RESUBMITTED // FDO resubmitted after retake
  FDO_REUPLOADED_DOCUMENT // FDO re-uploaded a specific document
  PROFILE_EDIT_RESET // Profile edit invalidated approval stage
  // Dynamic workflow level actions (used when ClientWorkflowConfig is active)
  LEVEL_APPROVED // Dynamic level approved & forwarded to next stage
  LEVEL_RETAKE_REQUESTED // Dynamic level requested corrections
  LEVEL_REJECTED // Dynamic level rejected the client
  // Per-document decisions by a custom-role dynamic stage (BM/AM/QC keep their own)
  LEVEL_VERIFIED_DOCUMENT
  LEVEL_RETAKE_DOCUMENT
  LEVEL_DELETED_DOCUMENT
  LEVEL_REJECTED_DOCUMENT
  REJECTION_REVOKED // Rejected client re-accessed — returned to the stage that rejected them
}

