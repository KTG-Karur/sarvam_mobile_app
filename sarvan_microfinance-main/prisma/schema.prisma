// ── Mobile MPIN change (forgot-MPIN) maker-checker ─────────────────────────
// Employee (mobile, self) requests a change → Admin/Sub Admin approves or
// rejects → only after APPROVED can the employee set a new MPIN via
// POST /api/mobile/mpin/change, which then flips the request to COMPLETED so
// the same approval can never authorize a second change.
enum MpinChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model MpinChangeRequest {
  id              String                  @id @default(cuid())
  employeeId      String
  status          MpinChangeRequestStatus @default(PENDING)
  requestedAt     DateTime                @default(now())
  approvedById    String?
  approvedAt      DateTime?
  rejectedById    String?
  rejectedAt      DateTime?
  rejectionReason String?
  completedAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  employee   User  @relation("MpinChangeRequestEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  approvedBy User? @relation("MpinChangeRequestApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  rejectedBy User? @relation("MpinChangeRequestRejectedBy", fields: [rejectedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([employeeId, status])
  @@map("mpin_change_requests")
}

// ── First due date change (Final Disbursement) maker-checker ───────────────
// BM raises a request (reason only) for a whole Loan Index that is in final
// disbursement (loans APPROVED_LEVEL2, not yet DISBURSED) → Admin/Sub Admin
// picks the new date and approves (applied to every non-disbursed loan of the
// index) or rejects. old/new dates are kept for audit.
enum FirstDueDateChangeStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model FirstDueDateChangeRequest {
  id              String                   @id @default(cuid())
  indexId         String
  branchId        String
  oldFirstDueDate DateTime?
  newFirstDueDate DateTime?
  reason          String
  status          FirstDueDateChangeStatus @default(PENDING)
  requestedById   String
  requestedAt     DateTime                 @default(now())
  decidedById     String?
  decidedAt       DateTime?
  decisionRemarks String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  index       LoanIndex @relation(fields: [indexId], references: [id], onDelete: Restrict)
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  requestedBy User      @relation("FirstDueDateChangeRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   User?     @relation("FirstDueDateChangeDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([indexId, status])
  @@index([branchId, status, createdAt])
  @@map("first_due_date_change_requests")
}

