generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  staffLoans                         StaffLoan[]                  @relation("StaffLoanEmployee")
  staffAdvances                      StaffAdvance[]               @relation("StaffAdvanceEmployee")
  staffAdvanceDecisions              StaffAdvanceDecision[]
  staffAdvanceTransactionsCreated    StaffAdvanceTransaction[]
  staffLoanDecisions                 StaffLoanDecision[]
  staffLoanTransactionsCreated       StaffLoanTransaction[]
  staffLoanSchemesCreated            StaffLoanScheme[]
  staffLoanWorkflowsCreated          StaffLoanWorkflowConfig[]
  id                                 String                       @id @default(cuid())
  employeeId                         String?                      @unique
  mobileNumber                       String?                      @unique
  email                              String?
  password                           String
  firstName                          String
  lastName                           String
  role                               String                       @default("FDO")
  // branchId: Source of truth for BM/FDO. For AREA_MANAGER, this is null — use areaManagerBranches instead.
  branchId                           String?
  dateOfJoining                      DateTime?
  isActive                           Boolean                      @default(true)
  createdAt                          DateTime                     @default(now())
  updatedAt                          DateTime                     @updatedAt
  previousFdoTransfers               CenterTransfer[]             @relation("PreviousFDOs")
  transferredByTransfers             CenterTransfer[]             @relation("TransferredByUsers")
  transferredToFdoTransfers          CenterTransfer[]             @relation("TransferredToFDOs")
  clientTransfersDone                ClientTransfer[]             @relation("ClientTransfersPerformed")
  approvedCenters                    Center[]                     @relation("ApprovedCenters")
  createdCenters                     Center[]                     @relation("CreatedCenters")
  assignedCenters                    Center[]                     @relation("AssignedFDOs")
  enrolledClients                    Client[]                     @relation("EnrolledClients")
  verifiedClients                    Client[]                     @relation("VerifiedClients")
  bmReviewedClients                  Client[]                     @relation("BMReviewedClients")
  amReviewedClients                  Client[]                     @relation("AMReviewedClients")
  qcVerifiedClients                  Client[]                     @relation("QCVerifiedClients")
  orgScopes                          UserOrgScope[]
  finalReviewedClients               Client[]                     @relation("FinalReviewedClients")
  createdGroups                      Group[]                      @relation("CreatedGroups")
  uploadedKYCs                       KYC[]                        @relation("UploadedKYCs")
  verifiedKYCs                       KYC[]                        @relation("VerifiedKYCs")
  bmReviewedKYCs                     KYC[]                        @relation("BMReviewedKYCs")
  amReviewedKYCs                     KYC[]                        @relation("AMReviewedKYCs")
  qcReviewedKYCs                     KYC[]                        @relation("QCReviewedKYCs")
  kycStageReviews                    KycStageReview[]             @relation("KycStageReviewer")
  deletedKYCs                        KYC[]                        @relation("DeletedKYCs")
  approvalActions                    ClientApprovalHistory[]      @relation("ApprovalActionBy")
  loanApprovalActions                LoanApprovalHistory[]        @relation("LoanApprovalActionBy")
  createdLoanIndexes                 LoanIndex[]                  @relation("CreatedLoanIndexes")
  collectedTransactions              LoanTransaction[]            @relation("CollectedTransactions")
  approvedLoansLevel2                Loan[]                       @relation("ApprovedLoansLevel2")
  disbursedLoansByBM                 Loan[]                       @relation("DisbursedLoansByBM")
  createdLoanApplications            Loan[]                       @relation("CreatedLoanApplications")
  disbursedLoansLevel1               Loan[]                       @relation("DisbursedLoansLevel1")
  verifiedLoanApplications           Loan[]                       @relation("VerifiedLoanApplications")
  approvedTransactions               LoanTransaction[]            @relation("ApprovedTransactions")
  revertedTransactions               LoanTransaction[]            @relation("RevertedTransactions")
  refreshTokens                      RefreshToken[]
  branch                             Branch?                      @relation(fields: [branchId], references: [id])
  financialTransactions              FinancialTransaction[]
  attendance                         Attendance[]
  clientAttendances                  ClientAttendance[]
  branchTransfers                    BranchTransfer[]             @relation("CreatedBranchTransfers")
  leaveBalances                      EmployeeLeaveBalance[]
  salaryMaster                       EmployeeSalaryMaster[]
  employeeCtcMaster                  EmployeeCtcMaster?
  ctcMastersUpdated                  EmployeeCtcMaster[]          @relation("EmployeeCtcMasterUpdatedBy")
  ctcHistory                         EmployeeCtcHistory[]
  ctcHistoryChangedBy                EmployeeCtcHistory[]         @relation("EmployeeCtcHistoryChangedBy")
  salaryPayRecords                   SalaryPayRecord[]
  salaryPayRecordsApproved           SalaryPayRecord[]            @relation("SalaryPayApprovedBy")
  createdInsuranceRecords            InsuranceRecord[]            @relation("CreatedInsuranceRecords")
  createdDenominationEntries         DenominationEntry[]          @relation("CreatedDenominationEntries")
  submittedCollectionMeetingRecords  CollectionMeetingRecord[]    @relation("SubmittedCollectionMeetingRecords")
  initiatedForeclosureRequests       ForeclosureRequest[]         @relation("ForeclosureInitiatedBy")
  reviewedForeclosureRequests        ForeclosureRequest[]         @relation("ForeclosureReviewedBy")
  savingsRefundsInitiated            SavingsRefundRequest[]       @relation("SavingsRefundInitiatedBy")
  savingsRefundsReviewed             SavingsRefundRequest[]       @relation("SavingsRefundReviewedBy")
  savingsRefundsReverted             SavingsRefundRequest[]       @relation("SavingsRefundRequestRevertedBy")
  submittedEodCloseRequests          EodCloseRequest[]            @relation("SubmittedEodCloseRequests")
  reviewedEodCloseRequests           EodCloseRequest[]            @relation("ReviewedEodCloseRequests")
  interBranchTransfersCreated        InterBranchTransfer[]
  // NEW: Area Manager multi-branch assignments (1:N, max 4)
  areaManagerBranches                AreaManagerBranch[]          @relation("AreaManagerBranches")
  // Financial Transaction Approval workflow
  amApprovedFinancialTransactions    FinancialTransaction[]       @relation("AMApprovedFinancialTransactions")
  adminApprovedFinancialTransactions FinancialTransaction[]       @relation("AdminApprovedFinancialTransactions")
  rejectedFinancialTransactions      FinancialTransaction[]       @relation("RejectedFinancialTransactions")
  revertedFinancialTransactions      FinancialTransaction[]       @relation("RevertedFinancialTransactions")
  transactionApprovalActions         TransactionApprovalHistory[] @relation("TransactionApprovalActions")
  eodRevertHistoryActions            EodRevertHistory[]           @relation("EodRevertHistoryActions")
  createdLedgerOpeningBalances       LedgerOpeningBalance[]       @relation("CreatedLedgerOpeningBalances")
  updatedLedgerOpeningBalances       LedgerOpeningBalance[]       @relation("UpdatedLedgerOpeningBalances")
  createdSelfAccountOpeningBalances  SelfAccountOpeningBalance[]  @relation("CreatedSelfAccountOpeningBalances")
  updatedSelfAccountOpeningBalances  SelfAccountOpeningBalance[]  @relation("UpdatedSelfAccountOpeningBalances")
  // Gold Loan
  goldTransactionsInitiated          GoldTransaction[]            @relation("GoldTransactionInitiated")
  goldTransactionsApproved           GoldTransaction[]            @relation("GoldTransactionApproved")
  goldTransactionsRejected           GoldTransaction[]            @relation("GoldTransactionRejected")
  goldPricesCreated                  GoldPrice[]                  @relation("GoldPriceCreatedBy")
  goldPricesUpdated                  GoldPrice[]                  @relation("GoldPriceUpdatedBy")
  incentiveConfigsUpdated            IncentiveConfig[]            @relation("IncentiveConfigUpdatedBy")
  memberIndividualsCreated           MemberIndividual[]           @relation("MemberIndividualCreatedBy")
  memberIndividualPhotosUploaded     MemberIndividualPhoto[]      @relation("MemberIndividualPhotoUploadedBy")
  goldLoanDetailPhotosUploaded       GoldLoanDetailPhoto[]        @relation("GoldLoanDetailPhotoUploadedBy")
  grtSessionsCreated                 GrtSession[]                 @relation("GrtSessionCreatedBy")
  grtSessionsCompleted               GrtSession[]                 @relation("GrtSessionCompletedBy")
  grtSessionAnswersSubmitted         GrtSessionAnswer[]           @relation("GrtSessionAnswerSubmittedBy")
  grtSessionPhotosUploaded           GrtSessionPhoto[]            @relation("GrtSessionPhotoUploadedBy")
  coApplicantsCreated                CoApplicant[]                @relation("CoApplicantCreatedBy")
  coApplicantsBMReviewed             CoApplicant[]                @relation("CoApplicantBMReviewer")
  coApplicantsAMReviewed             CoApplicant[]                @relation("CoApplicantAMReviewer")
  coApplicantsQCReviewed             CoApplicant[]                @relation("CoApplicantQCReviewer")
  coApplicantsAdminReviewed          CoApplicant[]                @relation("CoApplicantAdminReviewer")
  coApplicantsActivated              CoApplicant[]                @relation("CoApplicantActivatedBy")
  coApplicantsInactivated            CoApplicant[]                @relation("CoApplicantInactivatedBy")
  coApplicantHistoryEntries          CoApplicantHistory[]         @relation("CoApplicantHistoryPerformedBy")
  loanCoApplicantSnapshotsCreated    LoanCoApplicantSnapshot[]    @relation("LoanCoApplicantSnapshotCreatedBy")
  // ── NEW RBAC relations ──
  userRoles                          UserRoleAssignment[]         @relation("UserRoles")
  userBranchAccess                   UserBranchAccess[]           @relation("UserBranchAccess")
  // Division Manager assignment
  divisionId                         String?
  managedDivision                    Division?                    @relation("DivisionManagers", fields: [divisionId], references: [id])
  // Multi-branch assignments (all roles)
  branchAssignments                  UserBranchAssignment[]       @relation("UserBranchAssignments")
  fdoTasks                           FdoTask[]
  deathMarkingsCreated               LoanDeathMarking[]           @relation("LoanDeathMarkingCreatedBy")
  deathMarkingsReverted              LoanDeathMarking[]           @relation("LoanDeathMarkingRevertedBy")

  locationApprovedClients        Client[]                    @relation("LocationApprovedClients")
  relocationRequestedClients     Client[]                    @relation("RelocationRequestedClients")
  groupRequestedClients          Client[]                    @relation("ClientGroupRequestedBy")
  defaultMemberSetClients        Client[]                    @relation("DefaultMemberSetByClients")
  loanClosureRecordsCreated      LoanClosureRecord[]         @relation("LoanClosureRecordClosedBy")
  loanClosureRecordsReverted     LoanClosureRecord[]         @relation("LoanClosureRecordRevertedBy")
  highmarkReportsRequested       HighmarkReport[]            @relation("HighmarkReportsRequested")
  reportRequestsRequested        ReportRequest[]             @relation("ReportRequestRequestedBy")
  reportRequestsCancelled        ReportRequest[]             @relation("ReportRequestCancelledBy")
  uploanImportJobsCreated        UploanImportJob[]           @relation("UploanImportJobCreatedBy")
  uploanImportJobsReverted       UploanImportJob[]           @relation("UploanImportJobRevertedBy")
  closedMemberImportJobsCreated  ClosedMemberImportJob[]     @relation("ClosedMemberImportJobCreatedBy")
  closedMemberImportJobsReverted ClosedMemberImportJob[]     @relation("ClosedMemberImportJobRevertedBy")
  backupLoanEditLogs             BackupLoanEditLog[]         @relation("BackupLoanEditLogActions")
  loanFunderChangeLogs           LoanFunderChangeLog[]       @relation("LoanFunderChangeLogActions")
  clientIdChangeLogs             ClientIdChangeLog[]         @relation("ClientIdChangeLogActions")
  centerIdChangeLogs             CenterIdChangeLog[]         @relation("CenterIdChangeLogActions")
  loanScheduleEditLogs           LoanScheduleEditLog[]       @relation("LoanScheduleEditLogActions")
  // ── Employee extended profile ──
  fatherName                     String?
  motherName                     String?
  address                        String?
  education                      String?
  aadhaarNumber                  String?
  aadhaarDocUrl                  String?
  panNumber                      String?
  panDocUrl                      String?
  profilePhotoUrl                String?
  esiNumber                      String?
  pfNumber                       String?
  esiPfDocUrl                    String?
  latitude                       Float?
  longitude                      Float?
  locationPhotoUrl               String?
  hasChangedPassword             Boolean                     @default(false)
  // Per-platform login switches (Employees > Login Access). Inactive/deleted/exited users are blocked regardless.
  webLoginEnabled                Boolean                     @default(true)
  mobileLoginEnabled             Boolean                     @default(true)
  hasChangedProfilePhoto         Boolean                     @default(false)
  // ── ID card print tracking (app/lib/hr/id-card-reprint.ts) ──
  // Set when HR prints / downloads the card. idCardFingerprint hashes the fields
  // physically printed on it; when the live record no longer matches, the
  // Employee List flags the card "Reprint required".
  idCardIssuedAt                 DateTime?
  idCardFingerprint              String?
  // ── HR: org placement & lifecycle ──
  departmentId                   String?
  department                     Department?                 @relation(fields: [departmentId], references: [id])
  designationId                  String?
  designation                    Designation?                @relation(fields: [designationId], references: [id])
  /// Employee's assigned work shift (Shift Management, HR Administration) — plain current
  /// assignment, no effective-dated history. Punch/attendance calculation does not read this
  /// yet (still the single global Working Hours config in attendance-config.ts).
  shiftId                        String?
  shift                          Shift?                      @relation(fields: [shiftId], references: [id])
  /// Punch Radius management (HR → Attendance): when true, mobile PUNCH_IN is refused unless the
  /// phone is within the branch radius (app/lib/punch-radius.ts). Opt-in per employee.
  /// Org placement copied from the onboarding request at final approval (separate from `divisionId`
  /// above, which is the Division MANAGER assignment).
  orgRegionId                    String?
  orgRegion                      Region?                     @relation("UserOrgRegion", fields: [orgRegionId], references: [id])
  orgDivisionId                  String?
  orgDivision                    Division?                   @relation("UserOrgDivision", fields: [orgDivisionId], references: [id])
  punchRadiusLocked              Boolean                     @default(false)
  punchRadiusLogs                PunchRadiusLog[]            @relation("PunchRadiusLogEmployee")
  punchRadiusChanges             PunchRadiusLog[]            @relation("PunchRadiusLogChangedBy")
  dateOfExit                     DateTime?
  confirmationDate               DateTime?
  // Explicit reporting-manager links (not derived from designation grade — see
  // Designation.grade comment). Used to route Leave/Transfer/Exit approvals.
  reportingManagerL1Id           String?
  reportingManagerL1             User?                       @relation("ReportingManagerL1", fields: [reportingManagerL1Id], references: [id])
  directReportsL1                User[]                      @relation("ReportingManagerL1")
  reportingManagerL2Id           String?
  reportingManagerL2             User?                       @relation("ReportingManagerL2", fields: [reportingManagerL2Id], references: [id])
  directReportsL2                User[]                      @relation("ReportingManagerL2")
  reportingManagerL3Id           String?
  reportingManagerL3             User?                       @relation("ReportingManagerL3", fields: [reportingManagerL3Id], references: [id])
  directReportsL3                User[]                      @relation("ReportingManagerL3")
  // ── HR: personal details ──
  gender                         String?
  dob                            DateTime?
  maritalStatus                  String?
  bloodGroup                     String?
  uanNumber                      String?
  // ── HR: emergency contact ──
  emergencyContactName           String?
  emergencyContactRelation       String?
  emergencyContactMobile         String?
  // ── HR: address (existing `address` field above is the current address) ──
  permanentAddress               String?
  sameAsCurrentAddress           Boolean                     @default(false)
  // ── HR: bank details ──
  bankName                       String?
  bankBranchName                 String?
  bankAccountNumber              String?
  bankIfscCode                   String?
  // ── HR: identity documents not covered above ──
  dlNumber                       String?
  voterIdNumber                  String?
  // ── HR: insurance (single flat record — see EmployeeOnboardingRequest for why
  // this isn't modeled on the client-shaped InsuranceRecord) ──
  insuranceCompanyName           String?
  insurancePolicyNumber          String?
  insuranceValidFrom             DateTime?
  insuranceValidTo               DateTime?
  // ── HR: family details (fatherName/motherName above already existed;
  // these are the fields the onboarding form's screenshot added around them) ──
  fatherAge                      Int?
  fatherAadhaarNumber            String?
  motherAge                      Int?
  motherAadhaarNumber            String?
  wifeName                       String?
  wifeAge                        Int?
  wifeAadhaarNumber              String?
  wifeBankAccountNumber          String?
  wifeIfscCode                   String?
  wifeContactNumber              String?
  husbandName                    String?
  husbandAge                     Int?
  husbandAadhaarNumber           String?
  husbandBankAccountNumber       String?
  husbandIfscCode                String?
  husbandContactNumber           String?
  weddingDate                    DateTime?
  /// Array<{ gender: string; age: number; aadhaarNumber: string }>
  children                       Json?
  // ── HR: documents & belongings ──
  employeeDocumentsOwned         EmployeeDocument[]          @relation("EmployeeDocumentOwner")
  employeeDocumentsUploaded      EmployeeDocument[]          @relation("EmployeeDocumentUploadedBy")
  employeeDocumentsVerified      EmployeeDocument[]          @relation("EmployeeDocumentVerifiedBy")
  issuedBelongings               EmployeeIssuedBelonging[]   @relation("EmployeeIssuedBelongingOwner")
  belongingsIssuedByMe           EmployeeIssuedBelonging[]   @relation("EmployeeBelongingIssuedBy")
  belongingsReturnedToMe         EmployeeIssuedBelonging[]   @relation("EmployeeBelongingReturnedTo")
  // ── HR: lifecycle (Confirmation / Promotion / Transfer / Exit) ──
  confirmationsOwned             EmployeeConfirmation[]      @relation("EmployeeConfirmationOwner")
  confirmationsInitiated         EmployeeConfirmation[]      @relation("EmployeeConfirmationInitiatedBy")
  confirmationsReviewed          EmployeeConfirmation[]      @relation("EmployeeConfirmationReviewedBy")
  promotionsOwned                EmployeePromotion[]         @relation("EmployeePromotionOwner")
  promotionsInitiated            EmployeePromotion[]         @relation("EmployeePromotionInitiatedBy")
  promotionsReviewed             EmployeePromotion[]         @relation("EmployeePromotionReviewedBy")
  transfersOwned                 EmployeeTransfer[]          @relation("EmployeeTransferOwner")
  transfersRequested             EmployeeTransfer[]          @relation("EmployeeTransferRequestedBy")
  transfersReplacedBy            EmployeeTransfer[]          @relation("EmployeeTransferReplacement")
  exitRequestsOwned              EmployeeExitRequest[]       @relation("EmployeeExitOwner")
  exitRequestsInitiated          EmployeeExitRequest[]       @relation("EmployeeExitInitiatedBy")
  exitRequestsFinalApproved      EmployeeExitRequest[]       @relation("EmployeeExitFinalApprovedBy")
  exitClearanceItemsCleared      EmployeeExitClearanceItem[] @relation("ExitClearanceItemClearedBy")
  leaveApplicationsOwned         LeaveApplication[]          @relation("LeaveApplicationOwner")
  leaveApplicationsApproved      LeaveApplication[]          @relation("LeaveApplicationApprovedBy")
  leaveApplicationsCancelled     LeaveApplication[]          @relation("LeaveApplicationCancelledBy")
  permissionRequestsOwned        PermissionRequest[]         @relation("PermissionRequestOwner")
  permissionRequestsApproved     PermissionRequest[]         @relation("PermissionRequestApprovedBy")
  permissionRequestsCancelled    PermissionRequest[]         @relation("PermissionRequestCancelledBy")
  performanceGoalsOwned          PerformanceGoal[]           @relation("PerformanceGoalOwner")
  performanceGoalsCreated        PerformanceGoal[]           @relation("PerformanceGoalCreatedBy")
  performanceReviewsOwned        PerformanceReview[]         @relation("PerformanceReviewOwner")
  performanceReviewsGiven        PerformanceReview[]         @relation("PerformanceReviewReviewer")
  policyDocumentsUploaded        PolicyDocument[]            @relation("PolicyDocumentUploadedBy")
  locationPings                  EmployeeLocationPing[]      @relation("EmployeeLocationPingOwner")
  trackingEvents                 EmployeeTrackingEvent[]     @relation("EmployeeTrackingEventOwner")
  routeSnapshots                 EmployeeRouteSnapshot[]     @relation("EmployeeRouteSnapshotOwner")
  // ── HR: New Employee Onboarding ──
  onboardingRequestsCreated      EmployeeOnboardingRequest[] @relation("OnboardingCreatedBy")
  onboardingRequestsAsManager    EmployeeOnboardingRequest[] @relation("OnboardingReportingManager")
  onboardingRequestProvisioned   EmployeeOnboardingRequest?  @relation("OnboardingCreatedUser")
  onboardingDocumentsUploaded    OnboardingDocument[]        @relation("OnboardingDocUploadedBy")
  // ── Mobile device binding ──
  // One employee = one bound mobile device. Nullable + unique: Postgres treats
  // multiple NULLs as distinct, so unbound users don't collide, and once a
  // deviceId is claimed by one user it cannot be claimed by another at the DB level.
  mobileDeviceId                 String?                     @unique
  // ── Mobile MPIN authentication ──
  // Bcrypt hash of the employee's 4-digit MPIN (never the raw digits). NULL = not yet created.
  mpinHash                       String?
  mpinFailedAttempts             Int                         @default(0)
  mpinLastFailedAt               DateTime?
  mpinChangeRequestsMade         MpinChangeRequest[]         @relation("MpinChangeRequestEmployee")
  mpinChangeRequestsApproved     MpinChangeRequest[]         @relation("MpinChangeRequestApprovedBy")
  mpinChangeRequestsRejected     MpinChangeRequest[]         @relation("MpinChangeRequestRejectedBy")
  firstDueDateChangeRequested    FirstDueDateChangeRequest[] @relation("FirstDueDateChangeRequestedBy")
  firstDueDateChangeDecided      FirstDueDateChangeRequest[] @relation("FirstDueDateChangeDecidedBy")
  // ── Face biometric attendance ──
  faceTemplate                   FaceTemplate?
  faceVerificationLogs           FaceVerificationLog[]
  faceReRegRequestsMade          FaceReRegistrationRequest[] @relation("FaceReRegRequestUser")
  faceReRegRequestsApproved      FaceReRegistrationRequest[] @relation("FaceReRegRequestApprovedBy")
  faceReRegRequestsRejected      FaceReRegistrationRequest[] @relation("FaceReRegRequestRejectedBy")
  // ── Single Device Login Access Control ──
  deviceAccessRequests           DeviceAccessRequest[]       @relation("DeviceAccessRequestUser")
  deviceAccessReviewed           DeviceAccessRequest[]       @relation("DeviceAccessRequestReviewer")
  deviceLoginHistories           DeviceLoginHistory[]        @relation("DeviceLoginHistoryUser")
  loginActivities                UserLoginActivity[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Branch {
  staffLoans                 StaffLoan[]
  staffAdvances              StaffAdvance[]
  staffLoanSchemes           StaffLoanScheme[]           @relation("StaffLoanSchemeBranches")
  id                         String                      @id @default(cuid())
  name                       String
  code                       String                      @unique
  address                    String?
  state                      String?
  district                   String?
  latitude                   Float?
  longitude                  Float?
  isActive                   Boolean                     @default(true)
  // Official date the branch opened for business (distinct from `createdAt`,
  // which is just when this DB row was created — e.g. during a later migration).
  branchStartDate            DateTime?
  // Date the branch's EOD/working-day cycle first started — distinct from
  // BranchLock.currentWorkingDate, which is the live, continuously-advancing
  // working day. This is a one-time historical marker.
  eodStartDate               DateTime?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  lock                       BranchLock?
  weekConfiguration          WeekConfiguration?
  holidays                   Holiday[]
  productMappings            BranchProductMapping[]
  centers                    Center[]
  loanIndexes                LoanIndex[]
  loanTransactions           LoanTransaction[]
  loans                      Loan[]
  users                      User[]
  financialTransactions      FinancialTransaction[]
  clientAttendances          ClientAttendance[]
  employeeAttendances        Attendance[]
  sentTransfers              BranchTransfer[]            @relation("FromBranch")
  receivedTransfers          BranchTransfer[]            @relation("ToBranch")
  insuranceRecords           InsuranceRecord[]
  denominationEntries        DenominationEntry[]
  collectionMeetingRecords   CollectionMeetingRecord[]
  foreclosureRequests        ForeclosureRequest[]
  firstDueDateChangeRequests FirstDueDateChangeRequest[]
  savingsRefundRequests      SavingsRefundRequest[]      @relation("BranchSavingsRefunds")
  eodRevertHistory           EodRevertHistory[]
  interBranchTransfersFrom   InterBranchTransfer[]       @relation("InterBranchTransferFromBranch")
  interBranchTransfersTo     InterBranchTransfer[]       @relation("InterBranchTransferToBranch")
  // NEW: Area Manager assignments that cover this branch
  areaManagerAssignments     AreaManagerBranch[]         @relation("AreaManagerBranches")
  // Multi-branch user assignments (all roles)
  userBranchAssignments      UserBranchAssignment[]      @relation("UserBranchAssignments")
  memberIndividuals          MemberIndividual[]
  grtSessions                GrtSession[]
  // RBAC relations
  userRoleAssignments        UserRoleAssignment[]
  userBranchAccess           UserBranchAccess[]          @relation("UserBranchAccess")
  // Area this branch belongs to (optional — for area-based grouping)
  areas                      Area[]
  goldPrices                 GoldPrice[]
  highmarkReports            HighmarkReport[]
  eodCloseRequests           EodCloseRequest[]
  ledgerOpeningBalances      LedgerOpeningBalance[]
  selfAccountOpeningBalances SelfAccountOpeningBalance[]
  uploanImportJobs           UploanImportJob[]
  closedMemberImportJobs     ClosedMemberImportJob[]
  transfersFromBranch        EmployeeTransfer[]          @relation("TransferFromBranch")
  transfersToBranch          EmployeeTransfer[]          @relation("TransferToBranch")
  employeeLocationPings      EmployeeLocationPing[]      @relation("EmployeeLocationPingBranch")
  employeeTrackingEvents     EmployeeTrackingEvent[]     @relation("EmployeeTrackingEventBranch")
  onboardingRequests         EmployeeOnboardingRequest[]

  @@map("branches")
}

/// Junction table: maps an Area Manager (User) to up to 4 branches.
/// isPrimary = true marks the default branch used on login.
model AreaManagerBranch {
  id        String   @id @default(cuid())
  userId    String
  branchId  String
  /// Marks the default branch for AM login session.
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation("AreaManagerBranches", fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation("AreaManagerBranches", fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
  @@map("area_manager_branches")
}

/// Junction table: maps any User (any role) to multiple branches.
/// isPrimary = true marks the default branch used on login.
model UserBranchAssignment {
  id        String   @id @default(cuid())
  userId    String
  branchId  String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation("UserBranchAssignments", fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation("UserBranchAssignments", fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
  @@map("user_branch_assignments")
}

model Region {
  id                  String             @id @default(cuid())
  name                String
  code                String             @unique
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  divisions           Division[]
  onboardingRequests  EmployeeOnboardingRequest[]
  employeesInRegion   User[]                       @relation("UserOrgRegion")
  transfersFromRegion EmployeeTransfer[] @relation("TransferFromRegion")
  transfersToRegion   EmployeeTransfer[] @relation("TransferToRegion")
  orgScopes           UserOrgScope[]

  @@map("regions")
}

model Division {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  regionId  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  region    Region   @relation(fields: [regionId], references: [id])
  areas     Area[]
  onboardingRequests EmployeeOnboardingRequest[]
  employeesInDivision User[] @relation("UserOrgDivision")
  managers  User[]   @relation("DivisionManagers")
  orgScopes      UserOrgScope[]

  @@index([regionId])
  @@map("divisions")
}

model Area {
  id                String             @id @default(cuid())
  name              String
  code              String             @unique
  divisionId        String
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  division          Division           @relation(fields: [divisionId], references: [id])
  branches          Branch[]
  transfersFromArea EmployeeTransfer[] @relation("TransferFromArea")
  transfersToArea   EmployeeTransfer[] @relation("TransferToArea")
  orgScopes         UserOrgScope[]

  @@index([divisionId])
  @@map("areas")
}

enum OrgScopeLevel {
  HEAD_OFFICE // explicit "every branch" coverage — no regionId/divisionId/areaId
  REGION
  DIVISION
  AREA
}

/// Region / Division / Area coverage for a user (e.g. a Quality Checker) —
/// branch assignment one level up the hierarchy. Single branches stay in
/// UserBranchAssignment, so "Manage Branches" and "Assign Region / Area" always
/// show the same thing. "Every branch" is its own HEAD_OFFICE row: a QC's Head
/// Office home branch alone grants nothing (they see exactly what is ticked).
/// Exactly one of regionId/divisionId/areaId is set, matching `level` (none for HEAD_OFFICE).
/// Resolved to branch ids at query time (app/lib/permissions/org-scope.ts) and
/// folded into the user's assigned branches (app/lib/user-branch-assignments.ts),
/// so listings, the branch switcher and all actions honour it, and a branch
/// later added under an assigned Region/Division/Area is covered automatically.
/// Duplicates are prevented app-side (the API replaces the full set in one
/// transaction) — a @@unique over these nullable columns would not hold in
/// Postgres, where NULLs are distinct.
model UserOrgScope {
  id          String        @id @default(cuid())
  userId      String
  level       OrgScopeLevel
  regionId    String?
  divisionId  String?
  areaId      String?
  createdById String?
  createdAt   DateTime      @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  region   Region?   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  division Division? @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  area     Area?     @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_org_scopes")
}

model Department {
  staffLoanSchemes   StaffLoanScheme[]           @relation("StaffLoanSchemeDepartments")
  id                 String                      @id @default(cuid())
  /// Not @unique here — uniqueness is enforced by a partial index scoped to
  /// isActive: true (see prisma/migrations/manual_active_scoped_unique_indexes.sql),
  /// since Prisma's schema DSL can't express a filtered unique constraint.
  /// A deactivated department must not permanently block a new active one
  /// from reusing its name/code.
  name               String
  code               String
  isActive           Boolean                     @default(true)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  employees          User[]
  transfersFromDept  EmployeeTransfer[]          @relation("TransferFromDepartment")
  transfersToDept    EmployeeTransfer[]          @relation("TransferToDepartment")
  onboardingRequests EmployeeOnboardingRequest[]

  @@map("departments")
}

model Designation {
  id                 String                      @id @default(cuid())
  /// Not @unique — see Department.name's comment; same active-scoped
  /// partial index pattern applies here.
  name               String
  code               String
  /// Cosmetic seniority hint only (e.g. Promotion UI suggesting "next designation
  /// up") — never used to derive reporting-manager relationships; those are the
  /// explicit User.reportingManagerL1/L2/L3Id self-relations instead.
  grade              Int?
  /// Role slug auto-assigned at onboarding provisioning; null = keep FDO default.
  defaultRoleSlug    String?
  /// Payroll CTC split for employees holding this designation — basicPercent +
  /// hraPercent must equal 100 (enforced in app/api/hr/designations/route.ts,
  /// not a DB constraint; same convention as AccountGroup's app-level checks).
  /// Default 70/30 matches the org's existing payroll sheet convention.
  basicPercent       Decimal                     @default(70) @db.Decimal(5, 2)
  hraPercent         Decimal                     @default(30) @db.Decimal(5, 2)
  isActive           Boolean                     @default(true)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  employees          User[]
  promotionsFrom     EmployeePromotion[]         @relation("PromotionFromDesignation")
  promotionsTo       EmployeePromotion[]         @relation("PromotionToDesignation")
  onboardingRequests EmployeeOnboardingRequest[]

  @@map("designations")
}

enum EmployeeDocumentCategory {
  JOINING_KIT
  PRE_APPLICATION_ASSESSMENT
  KYC
  EDUCATION_CERTIFICATE
  APPOINTMENT_LETTER
  BANK_PASSBOOK
  BGV_REPORT
  RELIEVING_LETTER_PAYSLIP
  RESUME
  ORIGINAL_CERTIFICATE_ACK
}

enum EmployeeDocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

model EmployeeDocument {
  id              String                   @id @default(cuid())
  employeeId      String
  employee        User                     @relation("EmployeeDocumentOwner", fields: [employeeId], references: [id])
  category        EmployeeDocumentCategory
  /// Only meaningful when category = KYC (Aadhaar/PAN/DL/Voter ID/UAN/Photo).
  /// Free string backed by a UI constants file, not a second lookup table —
  /// keeps the schema simple for a field that's populated on ~1/10 rows.
  subtype         String?
  fileUrl         String
  fileName        String
  fileSize        Int?
  mimeType        String?
  uploadedById    String
  uploadedBy      User                     @relation("EmployeeDocumentUploadedBy", fields: [uploadedById], references: [id])
  uploadedAt      DateTime                 @default(now())
  verifiedById    String?
  verifiedBy      User?                    @relation("EmployeeDocumentVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt      DateTime?
  status          EmployeeDocumentStatus   @default(PENDING)
  rejectionReason String?
  remarks         String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([employeeId, category])
  @@map("employee_documents")
}

enum OnboardingDocumentUploaderType {
  HR
  JOINEE
}

/// Documents attached to an EmployeeOnboardingRequest before any User exists
/// (Generate Link / Manual Entry / the public joinee form all feed into this).
/// Reuses EmployeeDocumentCategory/EmployeeDocumentStatus rather than
/// introducing parallel enums. Copied into EmployeeDocument at final approval
/// (app/api/hr/onboarding/[id]/action/route.ts) once the real User exists, so
/// both copies persist independently — this row is onboarding history, the
/// EmployeeDocument row is the permanent, verifiable record.
model OnboardingDocument {
  id                  String                         @id @default(cuid())
  onboardingRequestId String
  onboardingRequest   EmployeeOnboardingRequest      @relation(fields: [onboardingRequestId], references: [id])
  category            EmployeeDocumentCategory
  subtype             String?
  fileUrl             String
  fileName            String
  fileSize            Int?
  mimeType            String?
  uploaderType        OnboardingDocumentUploaderType @default(HR)
  uploadedById        String?
  uploadedBy          User?                          @relation("OnboardingDocUploadedBy", fields: [uploadedById], references: [id])
  /// Display fallback when uploaderType = JOINEE (uploadedById is null — no
  /// User exists yet); set to the request's employeeName at upload time.
  uploadedByName      String?
  uploadedAt          DateTime                       @default(now())
  status              EmployeeDocumentStatus         @default(PENDING)
  remarks             String?
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt

  @@index([onboardingRequestId, category])
  @@map("onboarding_documents")
}

/// Admin-configurable catalog of items issued to employees by role (e.g. FDO →
/// collection bag, ID card). Keyed by roleSlug, matching how ApprovalStage
/// already keys everything off role rather than designation.
model EmployeeBelongingItem {
  id            String                    @id @default(cuid())
  roleSlug      String
  itemName      String
  description   String?
  isActive      Boolean                   @default(true)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  issuedRecords EmployeeIssuedBelonging[]

  // No @@unique([roleSlug, itemName]) here — same active-scoped partial
  // index pattern as Department.name (see its comment); enforced via
  // prisma/migrations/manual_active_scoped_unique_indexes.sql instead.
  @@map("employee_belonging_items")
}

enum EmployeeIssuedBelongingStatus {
  ISSUED
  RETURNED
  LOST
  DAMAGED
}

model EmployeeIssuedBelonging {
  id              String                         @id @default(cuid())
  employeeId      String
  employee        User                           @relation("EmployeeIssuedBelongingOwner", fields: [employeeId], references: [id])
  belongingItemId String
  belongingItem   EmployeeBelongingItem          @relation(fields: [belongingItemId], references: [id])
  issuedDate      DateTime                       @default(now())
  issuedById      String
  issuedBy        User                           @relation("EmployeeBelongingIssuedBy", fields: [issuedById], references: [id])
  returnedDate    DateTime?
  returnedToId    String?
  returnedTo      User?                          @relation("EmployeeBelongingReturnedTo", fields: [returnedToId], references: [id])
  condition       String?
  remarks         String?
  status          EmployeeIssuedBelongingStatus  @default(ISSUED)
  /// Amount to recover from the employee for a LOST/DAMAGED item (final settlement).
  recoveryAmount  Decimal?                       @db.Decimal(12, 2)
  returnProofs    EmployeeBelongingReturnProof[]
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  @@index([employeeId])
  @@map("employee_issued_belongings")
}

/// Photo evidence captured when an issued belonging is handed back (returned
/// or returned damaged). Required by POST /api/hr/belongings/issued/[id]/return
/// for those outcomes; a LOST item records a recovery amount instead.
model EmployeeBelongingReturnProof {
  id                String                  @id @default(cuid())
  issuedBelongingId String
  issuedBelonging   EmployeeIssuedBelonging @relation(fields: [issuedBelongingId], references: [id], onDelete: Cascade)
  fileKey           String
  fileName          String
  mimeType          String
  fileSize          Int
  uploadedById      String
  createdAt         DateTime                @default(now())

  @@index([issuedBelongingId])
  @@map("employee_belonging_return_proofs")
}

/// Toggle-only admin config over the FIXED set of Employee Master fields
/// (modeled directly on EnrollmentValidationConfig) — not a dynamic
/// custom-field/EAV builder. isVisibleToEmployee additionally gates whether a
/// field shows on the employee's own "My Profile" self-service view.
model EmployeeFieldConfig {
  id                  String   @id @default(cuid())
  fieldKey            String   @unique
  fieldLabel          String
  section             String
  isRequired          Boolean  @default(false)
  isAlwaysRequired    Boolean  @default(false)
  isVisibleToEmployee Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("employee_field_configs")
}

/// Toggle-only admin config over the New Employee Onboarding form's own field
/// set (EmployeeOnboardingRequest / OnboardingRequestForm) — a separate table
/// from EmployeeFieldConfig on purpose: that one governs the Employee Master
/// edit form's field names (firstName, dob, bankAccountNumber, ...), a
/// different domain/namespace from onboarding's own (employeeName,
/// dateOfBirth, accountNumber, ...), mirroring how EnrollmentValidationConfig
/// itself is scoped to only one form rather than shared across unrelated ones.
model HrOnboardingFieldConfig {
  id               String   @id @default(cuid())
  fieldKey         String   @unique
  fieldLabel       String
  /// One of the onboarding form's 8 tabs: personal | address | organization |
  /// identity | bank | insurance | family | documents
  section          String
  isRequired       Boolean  @default(false)
  /// Locks isRequired server-side (see app/api/hr/onboarding-field-config/route.ts).
  /// Currently unused by any seeded row — branch (the one field the
  /// account-provisioning transaction genuinely can't run without) is
  /// hard-required by app/api/hr/onboarding/[id]/submit-for-approval/route.ts's
  /// own zod schema instead of a config row, since a toggle here could never
  /// actually govern it. Every field maps to a nullable User column (or has a
  /// safe fallback) and stays admin-toggleable even when it defaults to required.
  isAlwaysRequired Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([section])
  @@map("hr_onboarding_field_configs")
}

enum EmployeeLifecycleStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Confirmation: HR Initiation → Approval → Confirmation Completed → Confirmation
/// Letter. Bespoke maker-checker (mirrors ForeclosureRequest's shape) rather than
/// the generic ApprovalWorkflow engine — spec calls for exactly one approval step,
/// not configurable multi-level sequencing.
model EmployeeConfirmation {
  id                       String                  @id @default(cuid())
  employeeId               String
  employee                 User                    @relation("EmployeeConfirmationOwner", fields: [employeeId], references: [id])
  proposedConfirmationDate DateTime
  status                   EmployeeLifecycleStatus @default(PENDING)
  initiatedById            String
  initiatedBy              User                    @relation("EmployeeConfirmationInitiatedBy", fields: [initiatedById], references: [id])
  initiatedAt              DateTime                @default(now())
  reviewedById             String?
  reviewedBy               User?                   @relation("EmployeeConfirmationReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt               DateTime?
  reviewRemarks            String?
  letterGeneratedAt        DateTime?
  letterUrl                String?
  approvalInstanceId       String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@index([employeeId])
  @@index([approvalInstanceId])
  @@map("employee_confirmations")
}

/// Global configuration for employee probation period in months.
/// Singleton: exactly one row exists in the database.
model HrProbationConfig {
  id              String   @id @default(cuid())
  probationMonths Int      @default(6)
  updatedById     String?
  updatedAt       DateTime @updatedAt

  @@map("hr_probation_config")
}

/// Promotion: Initiation → Approval → Promotion Completed → Promotion Letter
/// (a DISTINCT letter template from Confirmation's). Same bespoke maker-checker
/// shape as EmployeeConfirmation.
model EmployeePromotion {
  id                 String                  @id @default(cuid())
  employeeId         String
  employee           User                    @relation("EmployeePromotionOwner", fields: [employeeId], references: [id])
  fromDesignationId  String?
  fromDesignation    Designation?            @relation("PromotionFromDesignation", fields: [fromDesignationId], references: [id])
  toDesignationId    String
  toDesignation      Designation             @relation("PromotionToDesignation", fields: [toDesignationId], references: [id])
  /// Optional salary change alongside the designation change — snapshotted
  /// from EmployeeCtcMaster at creation (fromMonthlyCtc) same as
  /// fromDesignationId; toMonthlyCtc null = title-only promotion, no CTC
  /// change. Applied to EmployeeCtcMaster + logged to EmployeeCtcHistory only
  /// once the promotion is actually APPROVED (see promotion-side-effects.ts).
  fromMonthlyCtc     Decimal?                @db.Decimal(15, 2)
  toMonthlyCtc       Decimal?                @db.Decimal(15, 2)
  effectiveDate      DateTime
  reason             String?
  status             EmployeeLifecycleStatus @default(PENDING)
  initiatedById      String
  initiatedBy        User                    @relation("EmployeePromotionInitiatedBy", fields: [initiatedById], references: [id])
  initiatedAt        DateTime                @default(now())
  reviewedById       String?
  reviewedBy         User?                   @relation("EmployeePromotionReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt         DateTime?
  reviewRemarks      String?
  letterGeneratedAt  DateTime?
  letterUrl          String?
  approvalInstanceId String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  ctcHistoryEntries  EmployeeCtcHistory[]

  @@index([employeeId])
  @@index([approvalInstanceId])
  @@map("employee_promotions")
}

enum EmployeeTransferType {
  BRANCH
  AREA
  REGION
  DEPARTMENT
}

/// Transfer: Requested → Level 1 → Configured Level(s) → Final Approval →
/// Transfer Completed, with admin-configurable approval levels. Deliberately
/// built on the generic ApprovalWorkflow/ApprovalStage/ApprovalInstance engine
/// (app/lib/approval/engine.ts, moduleSlug "hr-transfer") — its first real
/// production consumer — instead of a bespoke state machine, since this is
/// exactly the multi-stage, admin-configurable sequencing that engine exists
/// for. `status` mirrors ApprovalInstance.status for fast querying without a
/// join, kept in sync by the same transaction that calls processStageAction.
model EmployeeTransfer {
  id                    String               @id @default(cuid())
  employeeId            String
  employee              User                 @relation("EmployeeTransferOwner", fields: [employeeId], references: [id])
  transferType          EmployeeTransferType
  fromBranchId          String?
  fromBranch            Branch?              @relation("TransferFromBranch", fields: [fromBranchId], references: [id])
  toBranchId            String?
  toBranch              Branch?              @relation("TransferToBranch", fields: [toBranchId], references: [id])
  fromAreaId            String?
  fromArea              Area?                @relation("TransferFromArea", fields: [fromAreaId], references: [id])
  toAreaId              String?
  toArea                Area?                @relation("TransferToArea", fields: [toAreaId], references: [id])
  fromRegionId          String?
  fromRegion            Region?              @relation("TransferFromRegion", fields: [fromRegionId], references: [id])
  toRegionId            String?
  toRegion              Region?              @relation("TransferToRegion", fields: [toRegionId], references: [id])
  fromDepartmentId      String?
  fromDepartment        Department?          @relation("TransferFromDepartment", fields: [fromDepartmentId], references: [id])
  toDepartmentId        String?
  toDepartment          Department?          @relation("TransferToDepartment", fields: [toDepartmentId], references: [id])
  effectiveDate         DateTime
  reason                String?
  requestedById         String
  requestedBy           User                 @relation("EmployeeTransferRequestedBy", fields: [requestedById], references: [id])
  requestedAt           DateTime             @default(now())
  // The employee taking over the departing employee's current centers (FDO) or
  // branches (AREA_MANAGER) — required at create time whenever the departing
  // employee currently holds any; reassignment happens automatically on approval.
  replacementEmployeeId String?
  replacementEmployee   User?                @relation("EmployeeTransferReplacement", fields: [replacementEmployeeId], references: [id])
  approvalInstanceId    String?              @unique
  status                ApprovalStatus       @default(PENDING)
  completedAt           DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([employeeId])
  @@map("employee_transfers")
}

enum EmployeeExitType {
  VOLUNTARY_RESIGNATION
  ABSCONDING
  ASK_TO_GO
  APPOINTMENT_CANCELLATION
  TERMINATION
  DECEASED
  RETIREMENT
}

enum ExitClearanceDepartment {
  BM_FIELD
  AM_DIVISION
  AUDIT
  ACCOUNTS
  IT
  ADMIN
  FINAL_HR
}

/// Admin-configurable clearance checklist catalog, per department and
/// optionally scoped to specific exit types (empty exitTypes = applies to all).
/// Mirrors EnrollmentValidationConfig's toggle-config precedent.
model ExitClearanceItemConfig {
  id             String                      @id @default(cuid())
  department     ExitClearanceDepartment
  itemName       String
  exitTypes      EmployeeExitType[]
  isActive       Boolean                     @default(true)
  sortOrder      Int                         @default(0)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  clearanceItems EmployeeExitClearanceItem[]

  @@map("exit_clearance_item_configs")
}

enum EmployeeExitStatus {
  IN_PROGRESS
  HR_APPROVED
  REJECTED
  COMPLETED
}

/// Exit & Clearance: a PARALLEL fan-in gate, not a sequential approval — BM,
/// AM, Audit, Accounts, IT and Admin all clear their own checklist items
/// independently and in any order; only once every applicable item is CLEARED
/// does Final HR Approval become actionable. Deliberately bespoke (not the
/// generic ApprovalWorkflow engine, which models one linear active-stage queue
/// and can't represent an all-of/fan-in gate across parallel departments).
model EmployeeExitRequest {
  id                    String                      @id @default(cuid())
  employeeId            String
  employee              User                        @relation("EmployeeExitOwner", fields: [employeeId], references: [id])
  exitType              EmployeeExitType
  requestedDate         DateTime
  lastWorkingDate       DateTime
  reason                String?
  status                EmployeeExitStatus          @default(IN_PROGRESS)
  initiatedById         String
  initiatedBy           User                        @relation("EmployeeExitInitiatedBy", fields: [initiatedById], references: [id])
  initiatedAt           DateTime                    @default(now())
  finalHrApprovedById   String?
  finalHrApprovedBy     User?                       @relation("EmployeeExitFinalApprovedBy", fields: [finalHrApprovedById], references: [id])
  finalHrApprovedAt     DateTime?
  ndcGeneratedAt        DateTime?
  relievingLetterUrl    String?
  employeeDeactivatedAt DateTime?
  approvalInstanceId    String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  clearanceItems        EmployeeExitClearanceItem[]

  @@index([employeeId])
  @@index([approvalInstanceId])
  @@map("employee_exit_requests")
}

enum ExitClearanceItemStatus {
  PENDING
  CLEARED
  FLAGGED
}

/// One row per applicable ExitClearanceItemConfig, snapshotted at request-creation
/// time (department/itemName copied in) so a later edit to the config catalog
/// never retroactively changes an in-flight exit's checklist.
model EmployeeExitClearanceItem {
  id            String                  @id @default(cuid())
  exitRequestId String
  exitRequest   EmployeeExitRequest     @relation(fields: [exitRequestId], references: [id], onDelete: Cascade)
  configItemId  String
  configItem    ExitClearanceItemConfig @relation(fields: [configItemId], references: [id])
  department    ExitClearanceDepartment
  itemName      String
  status        ExitClearanceItemStatus @default(PENDING)
  clearedById   String?
  clearedBy     User?                   @relation("ExitClearanceItemClearedBy", fields: [clearedById], references: [id])
  clearedAt     DateTime?
  remarks       String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([exitRequestId, configItemId])
  @@map("employee_exit_clearance_items")
}

/// New Employee Onboarding: a joinee's details reach this table via one of two
/// intake paths — an Admin-generated public link the joinee fills in themselves
/// (source LINK, no auth, token-gated — see app/api/public/hr-onboarding), or an
/// Admin/HR user typing the same fields in directly (source MANUAL). Both paths
/// converge on the same pipeline: review → submitted into the generic
/// ApprovalWorkflow engine (moduleSlug "hr-onboarding", same engine as
/// EmployeeTransfer) → only once approved does the system generate an Employee ID
/// + password and provision the actual User login. Insurance fields are kept flat
/// here (and mirrored onto User on provisioning) rather than reusing
/// InsuranceRecord, which is shaped around client/loan insurance (non-nullable
/// clientId, globally-unique policyNumber) — bending it for a single flat
/// employee record isn't worth the coupling.
model EmployeeOnboardingRequest {
  id String @id @default(cuid())

  // ── Intake bookkeeping ──
  source          String // 'LINK' | 'MANUAL'
  status          String    @default("DRAFT") // DRAFT | SUBMITTED | IN_REVIEW | PENDING_APPROVAL | APPROVED | REJECTED
  publicToken     String?   @unique
  tokenExpiresAt  DateTime?
  tokenUsedAt     DateTime?
  createdByUserId String?
  createdBy       User?     @relation("OnboardingCreatedBy", fields: [createdByUserId], references: [id])

  // ── Form fields ──
  employeeName             String?
  branchId                 String?
  branch                   Branch?      @relation(fields: [branchId], references: [id])
  /// Org placement chosen when the request is raised. Region/Division are recorded for the
  /// request (a User's region/division is derived from branch → area); shiftId is copied onto
  /// the employee when they are created at final approval.
  regionId                 String?
  region                   Region?      @relation(fields: [regionId], references: [id])
  divisionId               String?
  division                 Division?    @relation(fields: [divisionId], references: [id])
  shiftId                  String?
  shift                    Shift?       @relation(fields: [shiftId], references: [id])
  designationId            String?
  designation              Designation? @relation(fields: [designationId], references: [id])
  departmentId             String?
  department               Department?  @relation(fields: [departmentId], references: [id])
  educationQualification   String?
  mobileNumber             String?
  email                    String?
  currentAddress           String?
  permanentAddress         String?
  dateOfBirth              DateTime?
  gender                   String?
  maritalStatus            String?
  emergencyContactName     String?
  emergencyContactRelation String?
  emergencyContactNumber   String?
  bloodGroup               String?
  aadhaarNumber            String?
  panNumber                String?
  dlNumber                 String?
  voterIdNumber            String?
  uanNumber                String?
  esiNumber                String?
  bankName                 String?
  bankBranchName           String?
  accountNumber            String?
  ifscCode                 String?
  reportingManagerId       String?
  reportingManager         User?        @relation("OnboardingReportingManager", fields: [reportingManagerId], references: [id])
  dateOfJoining            DateTime?
  insuranceCompanyName     String?
  insurancePolicyNumber    String?
  insuranceValidFrom       DateTime?
  insuranceValidTo         DateTime?
  /// Free "Status" field from the reference form — the request's own
  /// active/inactive draft flag, unrelated to the approval `status` above.
  requestStatus            String       @default("ACTIVE")

  // ── Family Details ──
  fatherName               String?
  fatherAge                Int?
  fatherAadhaarNumber      String?
  motherName               String?
  motherAge                Int?
  motherAadhaarNumber      String?
  wifeName                 String?
  wifeAge                  Int?
  wifeAadhaarNumber        String?
  wifeBankAccountNumber    String?
  wifeIfscCode             String?
  wifeContactNumber        String?
  husbandName              String?
  husbandAge               Int?
  husbandAadhaarNumber     String?
  husbandBankAccountNumber String?
  husbandIfscCode          String?
  husbandContactNumber     String?
  weddingDate              DateTime?
  /// Array<{ gender: string; age: number; aadhaarNumber: string }> — an
  /// admin-free-count repeatable list ("ADD" on the reference form), not
  /// worth a separate relational table for 3 flat fields each.
  children                 Json?

  // ── Approval workflow linkage ──
  approvalInstanceId     String?   @unique
  submittedForApprovalAt DateTime?
  rejectionReason        String?

  // ── Provisioning result (set on final approval) ──
  createdUserId       String?   @unique
  createdUser         User?     @relation("OnboardingCreatedUser", fields: [createdUserId], references: [id])
  generatedEmployeeId String?
  approvedAt          DateTime?

  onboardingDocuments OnboardingDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([branchId])
  @@map("employee_onboarding_requests")
}

enum PerformanceGoalStatus {
  OPEN
  ACHIEVED
  MISSED
  CANCELLED
}

model PerformanceGoal {
  id           String                @id @default(cuid())
  employeeId   String
  employee     User                  @relation("PerformanceGoalOwner", fields: [employeeId], references: [id])
  title        String
  description  String?
  targetDate   DateTime
  targetMetric String?
  status       PerformanceGoalStatus @default(OPEN)
  createdById  String
  createdBy    User                  @relation("PerformanceGoalCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([employeeId])
  @@map("performance_goals")
}

enum PerformanceReviewStatus {
  DRAFT
  SUBMITTED
  ACKNOWLEDGED
}

model PerformanceReview {
  id                String                  @id @default(cuid())
  employeeId        String
  employee          User                    @relation("PerformanceReviewOwner", fields: [employeeId], references: [id])
  reviewerId        String
  reviewer          User                    @relation("PerformanceReviewReviewer", fields: [reviewerId], references: [id])
  reviewPeriodStart DateTime
  reviewPeriodEnd   DateTime
  overallRating     Int
  comments          String?
  status            PerformanceReviewStatus @default(DRAFT)
  submittedAt       DateTime?
  acknowledgedAt    DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([employeeId])
  @@map("performance_reviews")
}

/// Company-wide, org-hierarchy-independent (unlike EmployeeDocument/insurance
/// docs, a policy applies to everyone, not one employee's folder tree).
model PolicyDocument {
  id           String    @id @default(cuid())
  title        String
  category     String?
  fileUrl      String
  fileName     String
  fileSize     Int?
  mimeType     String?
  isPublished  Boolean   @default(false)
  publishedAt  DateTime?
  uploadedById String
  uploadedBy   User      @relation("PolicyDocumentUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("policy_documents")
}

/// STAGED NARROWING (see attendance-hr/architecture-live-tracking.md, Phase 1
/// vs Phase 2): the target shape is EN_ROUTE | IDLE_PING only, once
/// scripts/backfill-tracking-events.ts has copied every historical
/// PUNCH_IN/PUNCH_OUT/CLIENT_VISIT row into EmployeeTrackingEvent. Kept at
/// its original 5 values for now so this push is purely additive (new table
/// only) — narrowing this enum before the backfill runs would make Postgres
/// unable to cast existing PUNCH_IN/PUNCH_OUT/CLIENT_VISIT rows to the new
/// type and fail the migration (or, worse, silently lose them). Do NOT
/// remove PUNCH_IN/PUNCH_OUT/CLIENT_VISIT from here until the backfill has
/// been run and verified — that's a deliberate follow-up edit, not this one.
enum EmployeeActivityType {
  PUNCH_IN
  PUNCH_OUT
  CLIENT_VISIT
  EN_ROUTE
  IDLE_PING
}

/// Append-only GPS ping log for Live Employee Tracking (HR Phase 7) — distinct
/// from Attendance's two-point-per-day checkIn/checkOut GPS fields (Phase 3),
/// which are correct for attendance verification but can't reconstruct a
/// route. New code only ever writes EN_ROUTE/IDLE_PING here (see
/// app/api/hr/tracking/ping/route.ts) — PUNCH_IN/PUNCH_OUT/CLIENT_VISIT now
/// go to EmployeeTrackingEvent instead. Historical rows of those three types
/// still exist here until scripts/backfill-tracking-events.ts is run; the
/// enum/clientId column stay as-is (not yet narrowed) until that backfill is
/// confirmed done — see the staged-narrowing note on EmployeeActivityType.
model EmployeeLocationPing {
  id             String               @id @default(cuid())
  employeeId     String
  employee       User                 @relation("EmployeeLocationPingOwner", fields: [employeeId], references: [id])
  latitude       Float
  longitude      Float
  accuracyMeters Float?
  /// Device battery level (0-100) at capture time, if the caller sent one —
  /// soft-capture like everything else on this model, never required.
  batteryPercent Float?
  capturedAt     DateTime             @default(now())
  activityType   EmployeeActivityType
  clientId       String?
  client         Client?              @relation("EmployeeLocationPingClient", fields: [clientId], references: [id])
  branchId       String?
  branch         Branch?              @relation("EmployeeLocationPingBranch", fields: [branchId], references: [id])
  createdAt      DateTime             @default(now())

  @@index([employeeId, capturedAt])
  @@index([branchId, capturedAt])
  @@map("employee_location_pings")
}

enum EmployeeTrackingEventType {
  PUNCH_IN
  PUNCH_OUT
  CLIENT_VISIT
  /// Written at the moment a collection is submitted (any of the 4
  /// collection routes — single/bulk/demand/arrear), reusing the GPS already
  /// captured on CollectionMeetingRecord.
  COLLECTION
  /// Written at the moment a Center is created, reusing Center's own
  /// required latitude/longitude.
  CENTER_CREATED
  /// Written at the moment a Client is enrolled, reusing Client's own
  /// captured latitude/longitude.
  MEMBER_ENROLLED
}

/// Discrete, business-meaningful location pins for Live Employee Tracking.
/// Punch In/Out and manual Client Visit are written by our own HR routes;
/// Collection/Center-Creation/Member-Enrollment are written by their owning
/// modules (Collections/Centers/Enrollment) as a soft, non-blocking insert
/// right after their own record is saved — see attendance-hr/architecture-live-tracking.md.
/// Kept separate from EmployeeLocationPing's continuous background
/// breadcrumbs so one table isn't doing double duty as both an event log and
/// a movement trail.
model EmployeeTrackingEvent {
  id             String                    @id @default(cuid())
  employeeId     String
  employee       User                      @relation("EmployeeTrackingEventOwner", fields: [employeeId], references: [id])
  eventType      EmployeeTrackingEventType
  latitude       Float
  longitude      Float
  accuracyMeters Float?
  batteryPercent Float?
  capturedAt     DateTime                  @default(now())
  /// Set only when eventType = CLIENT_VISIT or MEMBER_ENROLLED.
  clientId       String?
  client         Client?                   @relation("EmployeeTrackingEventClient", fields: [clientId], references: [id])
  /// Set only when eventType = COLLECTION or CENTER_CREATED. Deliberately a
  /// plain id, not a Prisma relation — avoids adding a back-relation field to
  /// the Center model, which belongs to a different module.
  centerId       String?
  /// Set only when eventType = PUNCH_IN/PUNCH_OUT — links back to the
  /// Attendance row this same punch created/updated.
  attendanceId   String?
  /// Human-readable description captured at write time (e.g. "Collection at
  /// Center ABC", "Created center \"XYZ\"", "Enrolled Jane Doe") — self
  /// contained, so the tracking read routes never need to join back to
  /// Center/Client for display text.
  label          String?
  branchId       String?
  branch         Branch?                   @relation("EmployeeTrackingEventBranch", fields: [branchId], references: [id])
  createdAt      DateTime                  @default(now())

  @@index([employeeId, capturedAt])
  @@index([branchId, capturedAt])
  @@map("employee_tracking_events")
}

/// Cached road-snapped path for one employee's one calendar day (Google
/// Roads API result) — see attendance-hr/plan-road-snapped-tracking-map.md
/// §4a. `pointCount` is a cheap staleness fingerprint: a finished day's raw
/// point count never changes, so a matching count means the cached path is
/// still valid and the paid API is never re-hit for it. Only "today" (while
/// the employee is still actively punched in and pinging) ever recomputes,
/// because its pointCount keeps growing.
model EmployeeRouteSnapshot {
  id          String   @id @default(cuid())
  employeeId  String
  employee    User     @relation("EmployeeRouteSnapshotOwner", fields: [employeeId], references: [id])
  date        DateTime // calendar-day bucket, same convention as Attendance.date (dayStartUtc)
  pointCount  Int
  snappedPath Json // [{ latitude, longitude }, ...]
  provider    String // "google" today; kept generic in case another provider is added later
  computedAt  DateTime @default(now())

  @@unique([employeeId, date])
  @@map("employee_route_snapshots")
}

model Center {
  idChangeLogs             CenterIdChangeLog[]
  id                       String                    @id @default(cuid())
  name                     String
  // Plain per-branch sequence number ("1", "2", ...) — not globally unique;
  // each branch independently numbers its own centers starting from 1.
  code                     String
  branchId                 String
  isActive                 Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  status                   CenterStatus              @default(PENDING_APPROVAL)
  createdById              String
  approvedById             String?
  approvedAt               DateTime?
  rejectionReason          String?
  address                  String?
  localArea                String?
  fdoId                    String?
  formationDate            DateTime?
  latitude                 Float?
  longitude                Float?
  meetingDay               String?
  meetingPlace             String?
  meetingTime              String?
  // No longer written by application code — computed dynamically from meetingDay
  // at read time (see app/lib/collections/next-meeting-date.ts). Retained only for
  // legacy display-only report consumers (dcb-aggregation, portfolio center-master, etc.).
  nextMeetingDate          DateTime?
  transferHistory          CenterTransfer[]
  oldClientTransfers       ClientTransfer[]          @relation("OldCenterTransfers")
  newClientTransfers       ClientTransfer[]          @relation("NewCenterTransfers")
  approvedBy               User?                     @relation("ApprovedCenters", fields: [approvedById], references: [id])
  branch                   Branch                    @relation(fields: [branchId], references: [id])
  createdBy                User                      @relation("CreatedCenters", fields: [createdById], references: [id])
  fdo                      User?                     @relation("AssignedFDOs", fields: [fdoId], references: [id])
  clients                  Client[]
  groups                   Group[]
  requestedByClients       Client[]                  @relation("ClientRequestedCenter")
  loanIndexes              LoanIndex[]
  loanTransactions         LoanTransaction[]
  loans                    Loan[]
  centerLeaderId           String?
  centerLeader             Client?                   @relation("CenterLeader", fields: [centerLeaderId], references: [id])
  clientAttendances        ClientAttendance[]
  foreclosureRequests      ForeclosureRequest[]
  savingsRefundRequests    SavingsRefundRequest[]    @relation("CenterSavingsRefunds")
  memberIndividuals        MemberIndividual[]
  grtSessions              GrtSession[]
  collectionMeetingRecords CollectionMeetingRecord[]
  kmFromBranch             Float?
  contactPerson            String?
  contactNumber            String?

  @@unique([branchId, code])
  @@map("centers")
}

model Group {
  id                 String        @id @default(cuid())
  name               String
  // Plain per-center sequence number ("1", "2", ...) — not globally unique;
  // each center independently numbers its own groups starting from 1.
  code               String?
  centerId           String
  // Per-center sequence for auto-created groups ("<Center Name> - N").
  // NULL for legacy manually-named groups (Postgres treats NULLs as distinct in the unique index).
  groupNumber        Int?
  // Verbatim "Group" column text from a bulk uploan import row (e.g. "1-MUTHIRI THOTTAM 01"),
  // scoped per-center. Lets a later, separate import batch for the same center recognize
  // "this legacy group already exists" and reuse it instead of creating a duplicate Group —
  // matching on Group.name doesn't work for this because the stored name is auto-generated
  // ("<Center Name> - N"), not the source file's group name. NULL for non-import-created groups.
  legacySourceName   String?
  status             GroupStatus   @default(ACTIVE)
  createdById        String
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  members            GroupMember[]
  center             Center        @relation(fields: [centerId], references: [id], onDelete: Cascade)
  createdBy          User          @relation("CreatedGroups", fields: [createdById], references: [id])
  requestedByClients Client[]      @relation("ClientRequestedGroup")

  @@unique([centerId, groupNumber])
  @@unique([centerId, code])
  @@map("groups")
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  clientId  String
  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, clientId])
  @@map("group_members")
}

model Client {
  idChangeLogs ClientIdChangeLog[]
  id        String   @id @default(cuid())
  // Intentionally NOT @unique — the uploan/member bulk import (app/lib/services/
  // uploan-import-row.service.ts) preserves a legacy client ID verbatim, and the
  // legacy system itself sometimes reused the same ID for two different people
  // (see normalizeMemberId's doc comment in uploan-import.service.ts). Every OTHER
  // creation path (client-enrollment.service.ts, group-assignment.service.ts) always
  // computes a fresh, never-before-used value via its own max-sequence generator, so
  // this relaxation never causes a normally-enrolled client to collide with another —
  // it only permits the uploan import's intentional legacy duplicates. Every
  // `prisma.client.findUnique({ where: { clientId } })` lookup elsewhere in the app
  // was changed to `findFirst` to match (see git history on this comment's commit) —
  // for a non-duplicated clientId those behave identically; for a legacy duplicate,
  // such a lookup deterministically resolves to one of the matches, never both.
  clientId  String
  firstName String
  lastName  String
  phone     String?
  email     String?
  centerId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Legacy verification field — kept for backward compatibility with reports/loan eligibility
  verificationStatus ClientVerificationStatus @default(PENDING_VERIFICATION)
  enrolledById       String
  verifiedById       String?
  verifiedAt         DateTime?
  rejectionReason    String?

  // === CR-3: Staged Approval Workflow ===
  approvalStatus    ClientApprovalStatus @default(SUBMITTED)
  // BM (first-stage) review tracking
  bmReviewedById    String?
  bmReviewedAt      DateTime?
  bmRemarks         String?
  // AM (second-stage) review tracking
  amReviewedById    String?
  amReviewedAt      DateTime?
  amRemarks         String?
  // Quality Check (third stage — between AM and Admin)
  qcVerifiedById    String?
  qcVerifiedAt      DateTime?
  qcRemarks         String?
  // Final review (Branch Admin / HO Admin — fourth stage)
  finalReviewedById String?
  finalReviewedAt   DateTime?
  finalRemarks      String?

  // Client master data fields
  permanentAddress                  String?
  admissionFees                     Decimal?               @db.Decimal(10, 2)
  loanAdvance                       Decimal                @default(0) @db.Decimal(15, 2)
  age                               Int?
  bankAcNo                          String?
  bankAccountType                   String?
  bankBranch                        String?
  bankName                          String?
  caOtherIdNo                       String?
  caPancardNo                       String?
  caVoterIdNo                       String?
  caste                             String?
  community                         String?
  country                           String?                @default("India")
  dateOfBirth                       DateTime?
  district                          String?
  fatherName                        String?
  gender                            String?
  groupId                           String?
  houseStatus                       String?
  ifscCode                          String?
  maritalStatus                     String?
  mobileNumber                      String?
  monthlyFamilyExpense              Decimal?               @db.Decimal(15, 2)
  monthlyFamilyIncome               Decimal?               @db.Decimal(15, 2)
  motherName                        String?
  noOfChildren                      Int?
  nomineeAge                        Int?
  nomineeDateOfBirth                DateTime?
  nomineeGender                     String?
  nomineeName                       String?
  nomineeRelation                   String?
  nomineePhone                      String?
  otherIdNo                         String?
  pancardNo                         String?
  pincode                           String?
  postOffice                        String?
  qualification                     String?
  religion                          String?
  requestedAmount                   Decimal?               @db.Decimal(15, 2)
  requestedLoanProductTypeId        String?
  requestedLoanProductId            String?
  requestedLoanFrequency            String?
  requestedLoanPurposeTypeId        String?
  requestedLoanPurposeId            String?
  smartCardNo                       String?
  spouseDob                         DateTime?
  spouseMobileNumber                String?
  spouseGender                      String?
  spouseName                        String?
  state                             String?
  votersIdNo                        String?
  latitude                          Float?
  longitude                         Float?
  // ── Location Approval Workflow ──
  locationApprovalStatus            LocationApprovalStatus @default(PENDING_APPROVAL)
  locationApprovedById              String?
  locationApprovedAt                DateTime?
  locationApprovalRemarks           String?
  bmVisitLatitude                   Float? // BM's GPS coordinates captured at time of approval
  bmVisitLongitude                  Float?
  // Relocation request (FDO submits new coords → BM re-approves)
  pendingLatitude                   Float?
  pendingLongitude                  Float?
  relocationRequestedById           String?
  relocationRequestedAt             DateTime?
  relocationRemarks                 String?
  // ── Group Request (FDO requests at enrollment; BM finalizes via Group Assign) ──
  memberGroupStatus                 MemberGroupStatus?
  requestedCenterId                 String?
  requestedCenterName               String?
  requestedGroupId                  String?
  requestedGroupName                String?
  requestedByUserId                 String?
  requestedAt                       DateTime?
  // Legacy occupation fields - kept for backward compatibility during migration
  occupation                        String?
  spouseOccupation                  String?
  // New economic activity fields
  economicActivityTypeId            String?
  economicActivityId                String?
  spouseEconomicActivityTypeId      String?
  spouseEconomicActivityId          String?
  coApplicantEconomicActivityTypeId String?
  coApplicantEconomicActivityId     String?

  // ── Default Member (No Loan) flag — Admin/Sub Admin only. Blocks NEW loan
  // applications for this client (see LoanService.createLoanApplication);
  // does not affect any loan already in progress.
  isDefaultMember      Boolean   @default(false)
  defaultMemberReason  String?
  defaultMemberSetById String?
  defaultMemberSetAt   DateTime?

  // Relations
  center                     Center?                 @relation(fields: [centerId], references: [id])
  enrolledBy                 User                    @relation("EnrolledClients", fields: [enrolledById], references: [id])
  verifiedBy                 User?                   @relation("VerifiedClients", fields: [verifiedById], references: [id])
  bmReviewedBy               User?                   @relation("BMReviewedClients", fields: [bmReviewedById], references: [id])
  amReviewedBy               User?                   @relation("AMReviewedClients", fields: [amReviewedById], references: [id])
  qcVerifiedBy               User?                   @relation("QCVerifiedClients", fields: [qcVerifiedById], references: [id])
  finalReviewedBy            User?                   @relation("FinalReviewedClients", fields: [finalReviewedById], references: [id])
  economicActivityType       EconomicActivityType?   @relation("ClientEconomicActivityType", fields: [economicActivityTypeId], references: [id], onDelete: SetNull)
  economicActivity           EconomicActivity?       @relation("ClientEconomicActivity", fields: [economicActivityId], references: [id], onDelete: SetNull)
  spouseEconomicActivityType EconomicActivityType?   @relation("ClientSpouseEconomicActivityType", fields: [spouseEconomicActivityTypeId], references: [id], onDelete: SetNull)
  spouseEconomicActivity     EconomicActivity?       @relation("ClientSpouseEconomicActivity", fields: [spouseEconomicActivityId], references: [id], onDelete: SetNull)
  groupMemberships           GroupMember[]
  kycDocuments               KYC[]
  loanTransactions           LoanTransaction[]
  loanApplications           Loan[]
  approvalHistory            ClientApprovalHistory[]
  inactiveDate               DateTime?
  dropoutReason              String?
  coApplicants               CoApplicant[]
  clientAttendances          ClientAttendance[]
  insuranceRecords           InsuranceRecord[]
  transferHistory            ClientTransfer[]
  ledCenters                 Center[]                @relation("CenterLeader")
  foreclosureRequests        ForeclosureRequest[]
  savingsRefundRequests      SavingsRefundRequest[]  @relation("ClientSavingsRefunds")
  memberIndividuals          MemberIndividual[]
  grtSessionClients          GrtSessionClient[]      @relation("ClientGrtSessions")
  requestedLoanProductType   LoanProductType?        @relation("ClientRequestedProductType", fields: [requestedLoanProductTypeId], references: [id])
  requestedLoanProduct       LoanProduct?            @relation("ClientRequestedProduct", fields: [requestedLoanProductId], references: [id])
  requestedLoanPurposeType   LoanPurposeType?        @relation("ClientRequestedPurposeType", fields: [requestedLoanPurposeTypeId], references: [id])
  requestedLoanPurpose       LoanPurpose?            @relation("ClientRequestedPurpose", fields: [requestedLoanPurposeId], references: [id])
  deathMarkings              LoanDeathMarking[]
  locationApprovedBy         User?                   @relation("LocationApprovedClients", fields: [locationApprovedById], references: [id])
  relocationRequestedBy      User?                   @relation("RelocationRequestedClients", fields: [relocationRequestedById], references: [id])
  loanClosureRecords         LoanClosureRecord[]
  highmarkReports            HighmarkReport[]
  requestedCenter            Center?                 @relation("ClientRequestedCenter", fields: [requestedCenterId], references: [id])
  requestedGroup             Group?                  @relation("ClientRequestedGroup", fields: [requestedGroupId], references: [id])
  requestedByUser            User?                   @relation("ClientGroupRequestedBy", fields: [requestedByUserId], references: [id])
  defaultMemberSetBy         User?                   @relation("DefaultMemberSetByClients", fields: [defaultMemberSetById], references: [id])
  employeeLocationPings      EmployeeLocationPing[]  @relation("EmployeeLocationPingClient")
  employeeTrackingEvents     EmployeeTrackingEvent[] @relation("EmployeeTrackingEventClient")

  // clientId lost its implicit unique index when @unique was removed (see the field's own
  // doc comment) — this explicit index keeps every findFirst/findMany({ where: { clientId
  // } }) lookup across the app fast.
  @@index([clientId])
  // Same no-auto-FK-index gap as Loan — these cover the tracker/task-report
  // WHERE patterns (centerId scoping, enrolledById's monthly-enrollment count,
  // approvalStatus tab filters, isActive combined with centerId).
  @@index([centerId])
  @@index([centerId, isActive])
  @@index([enrolledById])
  @@index([approvalStatus])
  @@map("clients")
}

// A client may have several co-applicants over time (one per loan cycle);
// only one may be ACTIVE at a time, and each must pass BM->AM->QC->ADMIN
// review (mirrors the KYC model's per-stage decision columns) before it can
// be activated. The very first co-applicant ever created for a client is
// flagged isPrimary and is what client-facing pages/reports show.
enum CoApplicantStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ACTIVE
  INACTIVE
}

enum CoApplicantApprovalStage {
  BM
  AM
  QC
  ADMIN
}

enum CoApplicantDecision {
  PENDING
  APPROVED
  REJECTED
}

model CoApplicant {
  id                     String   @id @default(cuid())
  clientId               String
  isPrimary              Boolean  @default(false)
  name                   String
  gender                 String
  dateOfBirth            DateTime
  age                    Int
  // Legacy occupation field - kept for backward compatibility during migration
  occupation             String?
  // New economic activity fields
  economicActivityTypeId String?
  economicActivityId     String?
  relationWithClient     String
  mobileNumber           String
  voterIdNo              String?
  otherIdNo              String?
  pancardNo              String?

  // ── Approval workflow (BM -> AM -> QC -> Admin) ──
  status       CoApplicantStatus         @default(PENDING_APPROVAL)
  currentStage CoApplicantApprovalStage? @default(BM)

  bmDecision   CoApplicantDecision @default(PENDING)
  bmRemark     String?
  bmReviewerId String?
  bmReviewedAt DateTime?

  amDecision   CoApplicantDecision @default(PENDING)
  amRemark     String?
  amReviewerId String?
  amReviewedAt DateTime?

  qcDecision   CoApplicantDecision @default(PENDING)
  qcRemark     String?
  qcReviewerId String?
  qcReviewedAt DateTime?

  adminDecision   CoApplicantDecision @default(PENDING)
  adminRemark     String?
  adminReviewerId String?
  adminReviewedAt DateTime?

  // ── Active / inactive lifecycle audit ──
  createdById     String?
  activatedById   String?
  activatedAt     DateTime?
  inactivatedById String?
  inactivatedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client               Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  economicActivityType EconomicActivityType? @relation("CoApplicantEconomicActivityType", fields: [economicActivityTypeId], references: [id], onDelete: SetNull)
  economicActivity     EconomicActivity?     @relation("CoApplicantEconomicActivity", fields: [economicActivityId], references: [id], onDelete: SetNull)

  createdBy     User? @relation("CoApplicantCreatedBy", fields: [createdById], references: [id])
  bmReviewer    User? @relation("CoApplicantBMReviewer", fields: [bmReviewerId], references: [id])
  amReviewer    User? @relation("CoApplicantAMReviewer", fields: [amReviewerId], references: [id])
  qcReviewer    User? @relation("CoApplicantQCReviewer", fields: [qcReviewerId], references: [id])
  adminReviewer User? @relation("CoApplicantAdminReviewer", fields: [adminReviewerId], references: [id])
  activatedBy   User? @relation("CoApplicantActivatedBy", fields: [activatedById], references: [id])
  inactivatedBy User? @relation("CoApplicantInactivatedBy", fields: [inactivatedById], references: [id])

  kycDocuments  KYC[]
  history       CoApplicantHistory[]
  loanSnapshots LoanCoApplicantSnapshot[]

  @@index([clientId])
  @@map("co_applicants")
}

// Full audit trail of every co-applicant transition — created, each stage's
// approve/reject, activation, inactivation. Mirrors ClientApprovalHistory.
model CoApplicantHistory {
  id            String   @id @default(cuid())
  coApplicantId String
  action        String
  performedById String
  remarks       String?
  previousState String?
  newState      String?
  createdAt     DateTime @default(now())

  coApplicant CoApplicant @relation(fields: [coApplicantId], references: [id], onDelete: Cascade)
  performedBy User        @relation("CoApplicantHistoryPerformedBy", fields: [performedById], references: [id])

  @@index([coApplicantId])
  @@map("co_applicant_history")
}

model KYC {
  id             String  @id @default(cuid())
  clientId       String
  // Which co-applicant this document belongs to — null for client-owned docs.
  // Needed because a client can now have multiple co-applicants; without this,
  // co_applicant_* documents couldn't be told apart.
  coApplicantId  String?
  // Set only for docs re-uploaded during a Renewal Loan application (house
  // images, location QR, and any new co-applicant's docs). These get their own
  // BM/AM/QC decision cycle within the renewal approval chain without touching
  // the member's approved enrollment KYC (loanId = null).
  loanId         String?
  documentType   String
  documentNumber String?
  fileUrl        String?
  fileName       String?
  fileSize       Int?
  mimeType       String?

  // Legacy status field — kept for backward compatibility
  status          KYCStatus @default(PENDING_VERIFICATION)
  uploadedById    String
  verifiedById    String?
  verifiedAt      DateTime?
  rejectionReason String?

  // === CR-3: Per-document BM/AM review fields ===
  // BM (first-stage) document decision
  bmDecision   KYCDocumentDecision @default(PENDING)
  bmRemark     String?
  bmReviewerId String?
  bmReviewedAt DateTime?
  // AM (second-stage) document decision
  amDecision   KYCDocumentDecision @default(PENDING)
  amRemark     String?
  amReviewerId String?
  amReviewedAt DateTime?
  // QC (third-stage) document decision
  qcDecision   KYCDocumentDecision @default(PENDING)
  qcRemark     String?
  qcReviewerId String?
  qcReviewedAt DateTime?
  // Retake tracking
  retakeReason String?
  revisionNo   Int                 @default(1)
  parentKycId  String? // Links to previous revision if re-uploaded
  // Soft-delete for audit continuity (CR-3: Delete KYC = logical removal)
  isDeleted    Boolean             @default(false)
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  client      Client       @relation(fields: [clientId], references: [id])
  coApplicant CoApplicant? @relation(fields: [coApplicantId], references: [id], onDelete: Cascade)
  loan        Loan?        @relation("LoanRenewalKyc", fields: [loanId], references: [id], onDelete: Cascade)
  uploadedBy  User         @relation("UploadedKYCs", fields: [uploadedById], references: [id])
  verifiedBy  User?        @relation("VerifiedKYCs", fields: [verifiedById], references: [id])
  bmReviewer  User?        @relation("BMReviewedKYCs", fields: [bmReviewerId], references: [id])
  amReviewer  User?        @relation("AMReviewedKYCs", fields: [amReviewerId], references: [id])
  qcReviewer  User?        @relation("QCReviewedKYCs", fields: [qcReviewerId], references: [id])
  deletedBy   User?        @relation("DeletedKYCs", fields: [deletedById], references: [id])
  parentKyc   KYC?         @relation("KYCRevisions", fields: [parentKycId], references: [id])
  revisions   KYC[]        @relation("KYCRevisions")
  // Per-document decisions for dynamic-workflow stages held by any role OTHER
  // than branch-manager / area-manager / quality-checkers (those three keep
  // using the bm*/am*/qc* columns above). See app/lib/approval/kyc-stage-decisions.ts.
  stageReviews KycStageReview[]

  @@index([clientId, isDeleted])
  @@index([loanId])
  @@map("kyc_documents")
}

