enum FinancialTransactionType {
  BANK_RECEIPT
  BANK_PAYMENT
  CASH_RECEIPT
  CASH_PAYMENT
  CONTRA
  JOURNAL
}

enum InterBranchTransferMode {
  CASH
  BANK
}

enum InterBranchTransferStatus {
  POSTED
  REVERSED
  CANCELLED
}

model FinancialTransaction {
  staffLoanVoucherLinks StaffLoanVoucher[]
  id                    String                   @id @default(cuid())
  voucherNo             String                   @unique
  transactionDate       DateTime
  type                  FinancialTransactionType

  // Ownership context for branch-level reporting.
  // NOTE: historically we inferred branch from createdBy.branchId, which breaks
  // centralized/batch postings (GL sync, HO posting). This field makes branch
  // attribution explicit.
  branchId String?

  // Accounts
  selfAccountId   String?
  contraAccountId String? // Second self-account for CONTRA entries
  ledgerId        String? // Debit ledger (Bank Receipt/Payment, Journal)
  creditLedgerId  String? // Credit ledger for JOURNAL entries

  amount      Decimal @db.Decimal(15, 2)
  description String?

  // Opaque tag identifying the system posting that created this voucher, e.g.
  // "[POSTING:INDEX_DISBURSEMENT:{indexId}]" — lets a revert flow find exactly
  // the vouchers it posted without polluting the accountant-facing `description`
  // (which is rendered as-is on Trial Balance, GL-One/All, Ledger Report, Day
  // Book, and voucher print). Not used by every posting family — some older
  // ones (EOD collection/loan-advance) still embed their marker in `description`
  // instead; new marker-based lookups should prefer this column.
  postingMarker String?

  // Instrument Details
  instrumentNo   String?
  instrumentDate DateTime?
  bankName       String?

  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 3-level approval workflow fields
  approvalStatus    FinancialTransactionApprovalStatus @default(PENDING_APPROVAL)
  createdByRole     String?
  amApprovedById    String?
  amApprovedAt      DateTime?
  adminApprovedById String?
  adminApprovedAt   DateTime?
  rejectedById      String?
  rejectedAt        DateTime?
  rejectionReason   String?
  revertedById      String?
  revertedAt        DateTime?
  revertReason      String?
  revertLatitude  Float? // device/picked location captured when this was reverted (mandatory at the revert UI)
  revertLongitude Float?

  branch                  Branch?                      @relation(fields: [branchId], references: [id])
  selfAccount             SelfAccount?                 @relation("PrimaryAccount", fields: [selfAccountId], references: [id])
  contraAccount           SelfAccount?                 @relation("ContraAccount", fields: [contraAccountId], references: [id])
  ledger                  AccountLedger?               @relation("DebitLedger", fields: [ledgerId], references: [id])
  creditLedger            AccountLedger?               @relation("CreditLedger", fields: [creditLedgerId], references: [id])
  createdBy               User                         @relation(fields: [createdById], references: [id])
  amApprovedBy            User?                        @relation("AMApprovedFinancialTransactions", fields: [amApprovedById], references: [id])
  adminApprovedBy         User?                        @relation("AdminApprovedFinancialTransactions", fields: [adminApprovedById], references: [id])
  rejectedBy              User?                        @relation("RejectedFinancialTransactions", fields: [rejectedById], references: [id])
  revertedBy              User?                        @relation("RevertedFinancialTransactions", fields: [revertedById], references: [id])
  interBranchTransferFrom InterBranchTransfer?         @relation("InterBranchTransferFromTxn")
  interBranchTransferTo   InterBranchTransfer?         @relation("InterBranchTransferToTxn")
  approvalHistory         TransactionApprovalHistory[]
  savingsRefundRequest    SavingsRefundRequest?        @relation("SavingsRefundFinancialTransaction")

  @@index([branchId, transactionDate])
  @@index([approvalStatus])
  @@index([postingMarker])
  @@map("financial_transactions")
}

/**
 * Inter-branch transfers (HO ↔ Branch), recorded as a paired voucher set:
 * - From-branch: Payment voucher (HO Remittance ledger)
 * - To-branch:   Receipt voucher (HO Borrow ledger)
 * This is the canonical link that makes reconciliation, audit, and reversals safe.
 */
model InterBranchTransfer {
  id String @id @default(cuid())

  fromBranchId String
  toBranchId   String

  mode   InterBranchTransferMode
  status InterBranchTransferStatus @default(POSTED)

  transferDate DateTime
  amount       Decimal  @db.Decimal(15, 2)
  narration    String?

  // Paired vouchers (unique: each voucher can belong to only one transfer)
  fromTransactionId String @unique
  toTransactionId   String @unique

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fromBranch Branch @relation("InterBranchTransferFromBranch", fields: [fromBranchId], references: [id], onDelete: Restrict)
  toBranch   Branch @relation("InterBranchTransferToBranch", fields: [toBranchId], references: [id], onDelete: Restrict)

  fromTransaction FinancialTransaction @relation("InterBranchTransferFromTxn", fields: [fromTransactionId], references: [id], onDelete: Restrict)
  toTransaction   FinancialTransaction @relation("InterBranchTransferToTxn", fields: [toTransactionId], references: [id], onDelete: Restrict)

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([fromBranchId, transferDate])
  @@index([toBranchId, transferDate])
  @@map("inter_branch_transfers")
}

model Attendance {
  id                String           @id @default(cuid())
  userId            String
  date              DateTime
  status            AttendanceStatus @default(PRESENT)
  leaveTypeId       String?
  isHoliday         Boolean          @default(false)
  branchId          String?
  checkIn           DateTime?
  checkOut          DateTime?
  // ── HR Phase 3: GPS + face-verification linkage ──
  // Populated (soft-capture, never blocking) by the existing punch routes
  // (/api/auth/face/verify, /api/auth/attendance/device-biometric), which
  // already log lat/lng onto FaceVerificationLog per attempt — these fields
  // just copy that same GPS fix onto the Attendance row itself for reporting.
  checkInLatitude   Float?
  checkInLongitude  Float?
  checkInFaceLogId  String?
  checkOutLatitude  Float?
  checkOutLongitude Float?
  checkOutFaceLogId String?
  workingHours      Decimal?         @db.Decimal(5, 2)
  /// True once the permission-quota rule has forced this day to ABSENT with
  /// the Loss-of-Pay leave type (see PermissionRequest.triggeredLop). While
  /// true, punch-out still records checkOut/workingHours as normal but must
  /// not let the hours-derived status overwrite `status` back off ABSENT.
  lopLocked         Boolean          @default(false)
  /// True when `leaveTypeId` on this row came from a half-day leave (0.5 day)
  /// rather than a whole-day one — denormalized here (same pattern as
  /// `lopLocked`) so balance "used" tallies can weight this row 0.5 instead of
  /// 1 without needing to join back to LeaveApplication. See
  /// attendance-hr/plan-half-day-leave.md §9.
  isHalfDayLeave    Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user            User                 @relation(fields: [userId], references: [id])
  leaveType       LeaveType?           @relation(fields: [leaveTypeId], references: [id])
  branch          Branch?              @relation(fields: [branchId], references: [id])
  checkInFaceLog  FaceVerificationLog? @relation("AttendanceCheckInLog", fields: [checkInFaceLogId], references: [id])
  checkOutFaceLog FaceVerificationLog? @relation("AttendanceCheckOutLog", fields: [checkOutFaceLogId], references: [id])

  @@unique([userId, date])
  @@index([branchId, date])
  @@map("attendance")
}

/// STAGED NARROWING (same pattern as EmployeeActivityType above): the live DB
/// still has 1339 rows with the legacy value PRESET and 30 with FULL_DAY —
/// discovered when `prisma db push` refused to drop them without
/// --accept-data-loss. No row currently uses PRESENT at all, meaning the
/// PRESET -> PRESENT rename (and FULL_DAY removal) was made here in
/// schema.prisma at some point but never actually pushed/backfilled against
/// this database. Kept as a superset (PRESENT + the two legacy values) so
/// `db push` is a no-op here instead of destroying attendance history. Do NOT
/// remove PRESET/FULL_DAY until a backfill script has rewritten those rows to
/// PRESENT (or whatever the intended replacement is) and been verified — that
/// is a deliberate follow-up, not part of this change.
enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  HOLIDAY
  PRESET
  FULL_DAY
}

model FaceTemplate {
