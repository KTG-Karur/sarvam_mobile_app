  action          ModuleAction     @relation(fields: [actionId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]

  @@unique([moduleId, actionId])
  @@index([moduleId])
  @@index([actionId])
  @@map("permissions")
}

// ── RolePermission — role to permission mapping ──────────────────
model RolePermission {
  id           String           @id @default(cuid())
