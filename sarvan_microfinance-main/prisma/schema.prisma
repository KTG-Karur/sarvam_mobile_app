model Loan {
  id                             String                        @id @default(cuid())
  loanNumber                     String                        @unique
  clientId                       String
  centerId                       String
  branchId                       String
  applicationStatus              LoanApplicationStatus         @default(DRAFT)
  disbursementStatus             LoanDisbursementStatus        @default(PENDING_LEVEL1)
  amount                         Decimal                       @db.Decimal(15, 2)
  appliedAmount                  Decimal?                      @db.Decimal(15, 2)
  indexedAmount                  Decimal?                      @db.Decimal(15, 2)
  memberIndividualApprovedAmount Decimal?                      @db.Decimal(15, 2)
  interestRate                   Decimal                       @db.Decimal(5, 2)
  tenureMonths                   Int
  createdById                    String
  verifiedById                   String?
  verifiedAt                     DateTime?
  disbursedLevel1ById            String?
  disbursedLevel1At              DateTime?
  approvedLevel2ById             String?
  approvedLevel2At               DateTime?
  // BM final disbursement tracking (after AM approval)
  disbursedByBMId                String?
  disbursedByBMAt                DateTime?
  attendanceStatus               LoanAttendanceStatus?
  firstDueDate                   DateTime?
  rejectionReason                String?
  isActive                       Boolean                       @default(true)
  // True only for loans created by the bulk "Ongoing Loan Backup" Excel import at
  // /dashboard/masters/uploan/member (set from CreateBackupLoanInput.loanNumberOverride,
  // which only that import path ever supplies — see backup-loan.service.ts's
  // createLoanRecord). Used to hide migrated LoanTransaction rows from Day Book / EOD
  // Summary display queries without affecting the transaction ledger itself (PAR/CCR/DCB
  // still read it normally) or the single-entry "Ongoing Loan Backup" form.
  isBulkMemberImport             Boolean                       @default(false)
  /// Snapshot of the exact source this backup/migrated loan's schedule + transaction trail
  /// was replayed from — shape `{ loanCard: ParsedLoanCardReport | null, repayment:
  /// ParsedRepaymentReport | null, savingsPaid: number, principalPaid: number, interestPaid:
  /// number }`. Written at import time (backup-loan.service.ts) and re-written by the Loan
  /// History Edit tool (/dashboard/masters/uploan/loan-history) so that tool can edit and
  /// losslessly re-replay it. Null for loans imported before this field existed (the tool
  /// falls back to an approximate reconstruction from LoanSchedule/LoanTransaction) and for
  /// every live (non-backup) loan.
  migratedLoanSource             Json?
  // ── Renewal-loan approval (loans created via the Member Enrollment page's
  // "Renewal Loan" mode). These pass the same FDO -> BM -> AM -> QC -> Admin
  // chain as a new-member enrollment before entering Loan Indexation.
  // `renewalApprovalStatus` reuses the ClientApprovalStatus enum (SUBMITTED ..
  // APPROVED + dynamic PENDING_LEVEL_1..5). null for every non-renewal loan.
  isRenewalApplication           Boolean                       @default(false)
  renewalApprovalStatus          ClientApprovalStatus?
  // Proposed edits captured at renewal submission, applied to the Client only on
  // FINAL_APPROVE: `{ address fields, latitude, longitude, coApplicantMode:
  // 'existing'|'new', coApplicantId? }`.
  renewalProposedData            Json?
  createdAt                      DateTime                      @default(now())
  updatedAt                      DateTime                      @updatedAt
  frequency                      String?
  indexId                        String?
  interestPaid                   Decimal                       @default(0) @db.Decimal(15, 2)
  lastPaymentDate                DateTime?
  closedDate                     DateTime?
  loanProductId                  String?
  penaltiesPaid                  Decimal                       @default(0) @db.Decimal(15, 2)
  principalPaid                  Decimal                       @default(0) @db.Decimal(15, 2)
  savingsPaid                    Decimal                       @default(0) @db.Decimal(15, 2)
  loanPurposeId                  String? // Changed from purpose String? to loanPurposeId
  funderId                       String?
  schedules                      LoanSchedule[]
  collectionStats                LoanScheduleCollectionStats[] @relation("ScheduleStats")
  transactions                   LoanTransaction[]
  approvedLevel2By               User?                         @relation("ApprovedLoansLevel2", fields: [approvedLevel2ById], references: [id])
  disbursedByBM                  User?                         @relation("DisbursedLoansByBM", fields: [disbursedByBMId], references: [id])
  branch                         Branch                        @relation(fields: [branchId], references: [id])
  center                         Center                        @relation(fields: [centerId], references: [id])
  client                         Client                        @relation(fields: [clientId], references: [id])
  createdBy                      User                          @relation("CreatedLoanApplications", fields: [createdById], references: [id])
  disbursedLevel1By              User?                         @relation("DisbursedLoansLevel1", fields: [disbursedLevel1ById], references: [id])
  loanIndex                      LoanIndex?                    @relation(fields: [indexId], references: [id])
  loanProduct                    LoanProduct?                  @relation(fields: [loanProductId], references: [id])
  verifiedBy                     User?                         @relation("VerifiedLoanApplications", fields: [verifiedById], references: [id])
  funder                         Funder?                       @relation("LoanFunder", fields: [funderId], references: [id])
  loanPurpose                    LoanPurpose?                  @relation(fields: [loanPurposeId], references: [id]) // Add this relation
  isDead                         Boolean                       @default(false)
  deathMarkedDate                DateTime?
  closureReason                  LoanClosureReason?
  foreclosureRequests            ForeclosureRequest[]
  savingsRefundRequests          SavingsRefundRequest[]        @relation("LoanSavingsRefunds")
  goldLoanDetail                 GoldLoanDetail?
  goldTransactions               GoldTransaction[]
  goldLoanDetailPhotos           GoldLoanDetailPhoto[]
  deathMarking                   LoanDeathMarking[]
  loanClosureRecord              LoanClosureRecord[]
  coApplicantSnapshot            LoanCoApplicantSnapshot?
  insuranceRecords               InsuranceRecord[]
  memberIndividual               MemberIndividual?
  grtSessionClients              GrtSessionClient[]            @relation("LoanGrtSessions")
  backupLoanEditLogs             BackupLoanEditLog[]
  funderChangeLogs               LoanFunderChangeLog[]
  scheduleEditLogs               LoanScheduleEditLog[]
  renewalKycDocuments            KYC[]                         @relation("LoanRenewalKyc")
  renewalHistory                 LoanApprovalHistory[]

  // Postgres doesn't auto-index foreign key columns (unlike MySQL) — these
  // cover the WHERE patterns used constantly across the app (task-report,
  // client tracker's pre_disbursement/disbursed tabs, branches' derived-date
  // lookups): centerId/disbursementStatus filtered alone or together, plus
  // clientId and the disbursedByBMAt date-range scan.
  @@index([centerId])
  @@index([disbursementStatus])
  @@index([centerId, disbursementStatus])
  @@index([clientId])
  @@index([disbursedByBMAt])
  @@map("loans")
}

/// Audit trail for the Loan History Edit tool (/dashboard/masters/uploan/loan-history) — one
/// row per Save. That tool wipes and rebuilds a backup/migrated loan's LoanSchedule +
/// LoanTransaction trail from an edited Loan Card / Repayment grid, which is destructive and
/// otherwise leaves no record; this captures who/when/why plus a before-snapshot of the
/// loan's aggregates and prior `migratedLoanSource`.
model ClientIdChangeLog {
  id          String   @id @default(cuid())
  clientDbId  String
  oldClientId String
  newClientId String
  changedById String
  reason      String
  createdAt   DateTime @default(now())

  client    Client @relation(fields: [clientDbId], references: [id], onDelete: Cascade)
  changedBy User   @relation("ClientIdChangeLogActions", fields: [changedById], references: [id])

  @@index([clientDbId, createdAt])
  @@index([changedById])
  @@map("client_id_change_logs")
}

/// Audit trail for Admin/Sub Admin edits of Center.code (Center ID) from Create Center.
/// Shown in Super Control → Audit History alongside Member ID edits.
model CenterIdChangeLog {
  id          String   @id @default(cuid())
  centerDbId  String
  oldCode     String
  newCode     String
  changedById String
  reason      String
  createdAt   DateTime @default(now())

  center    Center @relation(fields: [centerDbId], references: [id], onDelete: Cascade)
  changedBy User   @relation("CenterIdChangeLogActions", fields: [changedById], references: [id])

  @@index([centerDbId, createdAt])
  @@index([changedById])
  @@map("center_id_change_logs")
}

