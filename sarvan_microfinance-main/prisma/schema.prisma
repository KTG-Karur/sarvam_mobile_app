// ── IncentiveConfig / IncentiveSlab — Admin-managed FDO incentive rules ──
// One generic (header + ordered slab rows) pair covers every configurable
// section of the Incentive Report calc engine (see app/lib/services/
// incentive-report.service.ts). Each configType documents how its slabs are
// interpreted; slabs are versioned like ClientWorkflowConfig (PUT deactivates
// the previous active row for that configType and creates a new one).
enum IncentiveConfigType {
  CATEGORY_RULE // Active Clients band -> Field Officer Category label (category on slab)
  GOLD_TARGET // branch type (category: NEW|EXISTING) -> target member count (rate)
  GOLD_ACHIEVEMENT_EXISTING // achieved-members band -> achievement% (rate) is looked up via a paired slab; see service
  GOLD_ACHIEVEMENT_NEW // same shape as GOLD_ACHIEVEMENT_EXISTING, for New branches
  GOLD_WEIGHT_SLAB // gram-weight band (minValue/maxValue) -> incentive per member (rate)
  JLG_INCENTIVE // single slab: per-member rate (rate)
  COLLECTION_INCENTIVE // category (A/B/C) + recovery% band (minValue/maxValue) -> incentive amount (rate)
  OD_COLLECTION_RATE // DPD band label (31-60/61-90/91-180/180+) -> incentive % (rate)
}

model IncentiveConfig {
  id          String              @id @default(cuid())
  configType  IncentiveConfigType
  isActive    Boolean             @default(true)
  updatedById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  slabs       IncentiveSlab[]
  updatedBy   User?               @relation("IncentiveConfigUpdatedBy", fields: [updatedById], references: [id])

  @@index([configType, isActive])
  @@map("incentive_configs")
}

model IncentiveSlab {
  id        String          @id @default(cuid())
  configId  String
  slabOrder Int
  label     String? // e.g. "Category A", "31-60 Days"
  category  String? // A/B/C or NEW/EXISTING — only for configTypes keyed by category
  minValue  Decimal?        @db.Decimal(12, 3) // lower bound (active clients / achieved members / recovery% / grams)
  maxValue  Decimal?        @db.Decimal(12, 3) // upper bound; null = open-ended top band
  rate      Decimal         @db.Decimal(12, 3) // ₹ amount, % rate, achievement %, or target count depending on configType
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  config    IncentiveConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, slabOrder])
  @@map("incentive_slabs")
}

// ── BrandConfig — Admin-controlled UI theme (singleton row) ─────────
// ── ThemePreset — Admin-managed UI theme presets (multiple rows, one active) ─────────
model ThemePreset {
  id                      String   @id @default(cuid())
  name                    String
  isActive                Boolean  @default(false) // app-enforced singleton-active, mirrors AreaManagerBranch.isPrimary — no partial unique index
  primaryColor            String   @default("#037f35")
  primaryDark             String   @default("#025c27")
  primaryDarker           String   @default("#013318")
  primaryLight            String   @default("#04a845")
  primaryTint             String   @default("#e6f5ec")
  secondaryColor          String   @default("#feb902")
  sidebarBg               String   @default("#013318")
  sidebarText             String   @default("#e6f5ec")
  sidebarFontSize         Float    @default(13)
  sidebarBrandFontSize    Float    @default(18) // px — the SHORT NAME (companyNameShort) in the sidebar header (SidebarBrand); independent of sidebarFontSize, which only styles menu items
  sidebarFullNameFontSize Float    @default(10) // px — the FULL NAME (companyNameFull) line under the short name in the sidebar header
  navBg                   String   @default("#ffffff")
  pageBg                  String   @default("#f4faf6")
  foregroundColor         String   @default("#0f1f12")
  fontSizeBase            Float    @default(14)
  logoWordmarkKey         String?
  logoIconKey             String?
  faviconKey              String?
  tamilLogoKey            String? // GCS object key — Tamil-language logo used on the passbook PDF and collection receipt print
  paymentQrKey            String? // GCS object key — this theme's own UPI/bank payment QR, shown on the passbook PDF
  paymentUpiNumber        String? // G-Pay / PhonePe number printed on the passbook PDF; blank = the line is omitted
  pageLoaderKey           String? // GCS object key — icon shown in the app-wide page loading spinner (falls back to logo-icon's default image when unset)
  loginAnimationKey       String?
  authorisedSignatoryKey  String? // GCS object key — scanned signature embedded in HR lifecycle letters (Confirmation/Promotion/Relieving); falls back to the bundled public/authorised_signatory.png when unset
  companyNameShort        String   @default("KTGT")
  companyNameFull         String   @default("Knock The Globe Technologies")
