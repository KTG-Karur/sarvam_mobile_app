  branch    Branch @relation(fields: [branchId], references: [id])
  loan      Loan?  @relation(fields: [loanId], references: [id])
  createdBy User   @relation("CreatedInsuranceRecords", fields: [createdById], references: [id])

  @@index([clientId])
  @@index([branchId])
  @@index([status])
  @@index([loanId])
  @@map("insurance_records")
}

// === CR-3: Client Approval Audit Trail ===
model ClientApprovalHistory {
  id            String         @id @default(cuid())
  clientId      String
  action        ApprovalAction
  performedById String
  remarks       String?
  kycDocumentId String? // If action is document-specific
  previousState String? // JSON snapshot of previous approval state
  newState      String? // JSON snapshot of new approval state
  createdAt     DateTime       @default(now())

  client      Client @relation(fields: [clientId], references: [id])
  performedBy User   @relation("ApprovalActionBy", fields: [performedById], references: [id])

  @@index([clientId])
  @@index([performedById])
  @@index([createdAt])
  @@map("client_approval_history")
}

// Audit trail for the renewal-loan approval chain (FDO -> BM -> AM -> QC ->
// Admin), the per-loan analogue of ClientApprovalHistory. `action` is a free
// string (e.g. FDO_SUBMITTED_RENEWAL, BM_COMPLETED_REVIEW, FINAL_APPROVED_LOAN).
model LoanApprovalHistory {
  id            String   @id @default(cuid())
  loanId        String
  action        String
  performedById String
  remarks       String?
  kycDocumentId String?
  previousState String?
  newState      String?
  createdAt     DateTime @default(now())

  loan        Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  performedBy User @relation("LoanApprovalActionBy", fields: [performedById], references: [id])

  @@index([loanId])
  @@index([performedById])
  @@index([createdAt])
  @@map("loan_approval_history")
}

// === 3-Level Financial Transaction Approval Workflow ===

enum FinancialTransactionApprovalStatus {
  PENDING_APPROVAL
  PENDING_AM_APPROVAL
  PENDING_ADMIN_APPROVAL
  APPROVED
  REJECTED
  REVERTED
}

enum TransactionApprovalAction {
  CREATED
  AUTO_APPROVED
  AM_APPROVED
  AM_REJECTED
  ADMIN_APPROVED
  ADMIN_REJECTED
  REVERTED
}

model TransactionApprovalHistory {
  id             String                             @id @default(cuid())
  transactionId  String
  action         TransactionApprovalAction
  performedById  String
  previousStatus FinancialTransactionApprovalStatus
  newStatus      FinancialTransactionApprovalStatus
  remarks        String?
  createdAt      DateTime                           @default(now())

  transaction FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  performedBy User                 @relation("TransactionApprovalActions", fields: [performedById], references: [id])

  @@index([transactionId])
  @@index([createdAt])
  @@map("transaction_approval_history")
}

// EodRevertHistory — audit trail for "Revert EOD" (undoing an end-of-day
// close and rewinding a branch's working date). BranchLock only ever holds
// the *current* working date, so without this table a revert leaves no
// persisted trace of what date it moved from/to, who did it, or why.
model EodRevertHistory {
  id              String   @id @default(cuid())
  branchId        String
  fromWorkingDate DateTime
  toWorkingDate   DateTime
  mode            String
  revertedById    String
  revertedAt      DateTime @default(now())
  revertReason    String
  revertLatitude  Float? // device/picked location captured when this was reverted (mandatory at the revert UI)
  revertLongitude Float?

  branch     Branch @relation(fields: [branchId], references: [id])
  revertedBy User   @relation("EodRevertHistoryActions", fields: [revertedById], references: [id])

  @@index([branchId, revertedAt])
  @@index([revertedById])
  @@map("eod_revert_history")
}

// === Denomination Entry (Branch-wise Daily Cash Count) ===
model DenominationEntry {
  id          String   @id @default(cuid())
  branchId    String
  entryDate   DateTime @db.Date
  d500        Int      @default(0)
  d200        Int      @default(0) // Add this line
  d100        Int      @default(0)
  d50         Int      @default(0)
  d20         Int      @default(0)
  d10         Int      @default(0)
  d5          Int      @default(0)
  d2          Int      @default(0)
  d1          Int      @default(0)
  upi         Decimal  @default(0) @db.Decimal(15, 2)
  totalAmount Decimal  @default(0) @db.Decimal(15, 2)
  remarks     String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch    Branch @relation(fields: [branchId], references: [id])
  createdBy User   @relation("CreatedDenominationEntries", fields: [createdById], references: [id])

  @@unique([branchId, entryDate])
  @@index([branchId, entryDate])
  @@map("denomination_entries")
}

// === Collection Meeting Record (per-batch FDO meeting photo + cash denomination) ===
// One row per demand-collection submission (collectionBatchId), captured before the
// batch is sent for BM approval. Independent from DenominationEntry (branch+day EOD
// cash count) — this is the per-meeting source data that the EOD denomination step
// aggregates for display/prefill only; it never feeds into the EOD match/validation math.
model CollectionMeetingRecord {
  id                String   @id @default(cuid())
  collectionBatchId String   @unique
  centerId          String
  branchId          String
  collectionDate    DateTime @db.Date

  photoKey String
  photoUrl String

  // FDO's device GPS at the moment the meeting photo was captured — soft capture,
  // recorded for audit only, never blocks submission when unavailable/denied.
  latitude  Float?
  longitude Float?

  d500        Int     @default(0)
  d200        Int     @default(0)
  d100        Int     @default(0)
  d50         Int     @default(0)
  d20         Int     @default(0)
  d10         Int     @default(0)
  d5          Int     @default(0)
  d2          Int     @default(0)
  d1          Int     @default(0)
  upi         Decimal @default(0) @db.Decimal(15, 2)
  totalAmount Decimal @default(0) @db.Decimal(15, 2)

  submittedById String
  submittedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  center      Center @relation(fields: [centerId], references: [id])
  branch      Branch @relation(fields: [branchId], references: [id])
  submittedBy User   @relation("SubmittedCollectionMeetingRecords", fields: [submittedById], references: [id])

  @@index([branchId, collectionDate])
  @@index([centerId, collectionDate])
  @@map("collection_meeting_records")
}

// === EOD Close Request (BM submits, AM approves before branch working date advances) ===
enum EodCloseRequestStatus {
  PENDING_AM_APPROVAL
  APPROVED
  REJECTED
}

model EodCloseRequest {
  id             String                @id @default(cuid())
  branchId       String
  workingDateYmd String
  status         EodCloseRequestStatus @default(PENDING_AM_APPROVAL)

  // Denomination snapshot — prefilled from CollectionMeetingRecord, BM-editable, saved to
  // DenominationEntry and copied here at submit time
  d500                    Int     @default(0)
  d200                    Int     @default(0)
  d100                    Int     @default(0)
  d50                     Int     @default(0)
  d20                     Int     @default(0)
  d10                     Int     @default(0)
  d5                      Int     @default(0)
  d2                      Int     @default(0)
  d1                      Int     @default(0)
  upi                     Decimal @default(0) @db.Decimal(15, 2)
  totalAmount             Decimal @default(0) @db.Decimal(15, 2)
  expectedCashCreditTotal Decimal @default(0) @db.Decimal(15, 2)

  submittedById   String
  submittedAt     DateTime  @default(now())
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch      Branch @relation(fields: [branchId], references: [id])
  submittedBy User   @relation("SubmittedEodCloseRequests", fields: [submittedById], references: [id])
  reviewedBy  User?  @relation("ReviewedEodCloseRequests", fields: [reviewedById], references: [id])

  @@unique([branchId, workingDateYmd])
  @@index([branchId, status])
  @@map("eod_close_requests")
}

// === Enrollment Validation Configuration ===
model EnrollmentValidationConfig {
  id               String   @id @default(cuid())
  fieldKey         String   @unique
  fieldName        String
  page             String // "kyc" | "client_details" | "client_other" | "co_applicant" | "loan_details"
  isRequired       Boolean  @default(false)
  isAlwaysRequired Boolean  @default(false) // locks the toggle for mandatory fields
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([page])
  @@map("enrollment_validation_configs")
}

// === Economic Activity Type & Activity ===
model EconomicActivityType {
  id          String   @id @default(cuid())
  typeId      String   @unique
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  economicActivities            EconomicActivity[]
  clientsWithActivityType       Client[]           @relation("ClientEconomicActivityType")
  clientsWithSpouseActivityType Client[]           @relation("ClientSpouseEconomicActivityType")
  coApplicants                  CoApplicant[]      @relation("CoApplicantEconomicActivityType")

  @@map("economic_activity_types")
}

// === Meeting Place (master list feeding the Center form's Meeting Place dropdown) ===
model MeetingPlace {
  id        String   @id @default(cuid())
  placeId   String   @unique
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("meeting_places")
}

model EconomicActivity {
  id                     String   @id @default(cuid())
  activityId             String   @unique
  name                   String
  economicActivityTypeId String
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  economicActivityType      EconomicActivityType @relation(fields: [economicActivityTypeId], references: [id], onDelete: Restrict)
  clients                   Client[]             @relation("ClientEconomicActivity")
  clientsWithSpouseActivity Client[]             @relation("ClientSpouseEconomicActivity")
  coApplicants              CoApplicant[]        @relation("CoApplicantEconomicActivity")

  @@index([economicActivityTypeId])
  @@map("economic_activities")
}

// === Questionnaire Master ===
enum QuestionType {
  TEXT
  YES_OR_NO
  MULTIPLE_CHOICE
  SINGLE_CHOICE
  IMAGE
}

enum QuestionnaireAuditType {
  PRE_AUDIT
  POST_AUDIT
}

model Questionnaire {
  id              String                 @id @default(cuid())
  questionnaireId String                 @unique
  title           String
  description     String?
  auditType       QuestionnaireAuditType @default(PRE_AUDIT)
  isPublished     Boolean                @default(true)
  isActive        Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  questions   Question[]
  grtSessions GrtSession[]

  @@map("questionnaires")
}

model Question {
  id              String       @id @default(cuid())
  questionnaireId String
  priorityOrder   Int
  question        String
  questionType    QuestionType
  weightage       Decimal?     @db.Decimal(10, 2)
  imageCount      Int?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  questionnaire     Questionnaire      @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  choices           QuestionChoice[]
  grtSessionAnswers GrtSessionAnswer[] @relation("GrtSessionAnswers")
  grtSessionPhotos  GrtSessionPhoto[]  @relation("GrtSessionPhotoQuestion")

  @@index([questionnaireId])
  @@map("questions")
}

model QuestionChoice {
  id         String   @id @default(cuid())
  questionId String
  choice     String
  weightage  Decimal  @db.Decimal(10, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_choices")
}

// === Gold Loan Module ===

enum GoldTransactionType {
  TAKE
  GIVE
}

enum GoldReturnStatus {
  PENDING
  APPROVED
  REJECTED
}

model GoldLoanDetail {
  id              String   @id @default(cuid())
  loanId          String   @unique
  karatType       String
  gramCount       Decimal  @db.Decimal(10, 3)
  goldTakenValue  Decimal  @db.Decimal(15, 2)
  cashGiven       Decimal  @db.Decimal(15, 2)
  goldTokenNo     String?
  itemDescription String?
  // Pledge remark entered by the BM at disbursement — distinct from
  // GoldTransaction.remarks, which is the remark on a take/return transaction
  // event, not the pledge record itself.
  remarks         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  loan Loan @relation(fields: [loanId], references: [id])

  @@map("gold_loan_details")
}

model GoldLoanDetailPhoto {
  id           String   @id @default(cuid())
  loanId       String
  photoUrl     String
  photoKey     String?
  uploadedById String
  createdAt    DateTime @default(now())

  loan       Loan @relation(fields: [loanId], references: [id])
  uploadedBy User @relation("GoldLoanDetailPhotoUploadedBy", fields: [uploadedById], references: [id])

  @@index([loanId])
  @@map("gold_loan_detail_photos")
}

model GoldTransaction {
  id                String              @id @default(cuid())
  loanId            String
  type              GoldTransactionType
  gramCount         Decimal             @db.Decimal(10, 3)
  goldValue         Decimal             @db.Decimal(15, 2)
  status            GoldReturnStatus    @default(PENDING)
  initiatedById     String
  approvedById      String?
  approvedAt        DateTime?
  rejectedById      String?
  rejectedAt        DateTime?
  rejectionReason   String?
  remarks           String?
  // Recipient of the gold on a GIVE (return) transaction — who physically
  // collected it, when it isn't the client themselves. Nullable at the DB
  // level (TAKE rows never set these); required at the API/UI layer for GIVE.
  recipientName     String?
  recipientMobile   String?
  recipientRelation String?
  recipientPhotoUrl String?
  recipientPhotoKey String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  loan         Loan              @relation(fields: [loanId], references: [id])
  initiatedBy  User              @relation("GoldTransactionInitiated", fields: [initiatedById], references: [id])
  approvedBy   User?             @relation("GoldTransactionApproved", fields: [approvedById], references: [id])
  rejectedBy   User?             @relation("GoldTransactionRejected", fields: [rejectedById], references: [id])
  returnPhotos GoldReturnPhoto[]

  @@index([loanId])
  @@index([type, status])
  @@index([createdAt])
  @@map("gold_transactions")
}

// Photos of the returned gold itself (GIVE transactions) — multiple per
// transaction. Distinct from GoldTransaction.recipientPhotoUrl, which is a
// single photo of the person who collected the gold, not the gold itself.
model GoldReturnPhoto {
  id                String   @id @default(cuid())
  goldTransactionId String
  photoUrl          String
  photoKey          String?
  createdAt         DateTime @default(now())

  goldTransaction GoldTransaction @relation(fields: [goldTransactionId], references: [id])

  @@index([goldTransactionId])
  @@map("gold_return_photos")
}

// Daily gold price master — set per branch by BM each day
model GoldPrice {
  id          String   @id @default(cuid())
  branchId    String
  k24Price    Decimal  @db.Decimal(10, 2)
  k22Price    Decimal  @db.Decimal(10, 2)
  k20Price    Decimal  @db.Decimal(10, 2)
  k18Price    Decimal  @db.Decimal(10, 2)
  k16Price    Decimal  @db.Decimal(10, 2)
  priceDate   DateTime @db.Date
  isActive    Boolean  @default(true)
  createdById String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch    Branch @relation(fields: [branchId], references: [id])
  createdBy User   @relation("GoldPriceCreatedBy", fields: [createdById], references: [id])
  updatedBy User?  @relation("GoldPriceUpdatedBy", fields: [updatedById], references: [id])

  @@index([branchId, priceDate])
  @@index([isActive])
  @@map("gold_prices")
}

// Post-indexation, pre-disbursement per-client data collection. One record
// per loan (not per client) — ties the AM disbursement gate to the specific
// index/disbursement cycle so a completed record from a prior loan never
// satisfies a new one. Completion is derived from the three *CompletedAt
// columns (all non-null = complete) rather than stored as a separate status.
// GRT is NOT part of this record — it's a separate center-wide grtSession
// (see below) covering multiple selected members at once.
model MemberIndividual {
  id       String @id @default(cuid())
  loanId   String @unique
  clientId String
  centerId String
  branchId String

  // Cash Flow tab
  foodExpense           Decimal?  @db.Decimal(10, 2)
  medicalExpense        Decimal?  @db.Decimal(10, 2)
  cookingFuelExpense    Decimal?  @db.Decimal(10, 2)
  electricityExpense    Decimal?  @db.Decimal(10, 2)
  transportExpense      Decimal?  @db.Decimal(10, 2)
  waterExpense          Decimal?  @db.Decimal(10, 2)
  educationalExpense    Decimal?  @db.Decimal(10, 2)
  monthlyExpense        Decimal?  @db.Decimal(10, 2)
  cashFlowCompletedAt   DateTime?
  cashFlowCompletedById String?

  // Loan Appraisal tab — the actual product change goes through the existing
  // /api/loans/[loanId]/update-product route; this just records the review.
  loanAppraisalReviewedAt   DateTime?
  loanAppraisalReviewedById String?

  // House Hold Visit tab
  visitLatitude                 Float?
  visitLongitude                Float?
  visitDistanceMeters           Float? // distance from Center.lat/lng at capture time
  visitDistanceFromClientMeters Float? // distance from Client.lat/lng — the FDO's enrollment-time location
  visitDistanceFromBranchMeters Float? // distance from Branch.lat/lng at capture time
  houseHoldVisitCompletedAt     DateTime?
  houseHoldVisitCompletedById   String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  loan      Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)
  client    Client @relation(fields: [clientId], references: [id])
  center    Center @relation(fields: [centerId], references: [id])
  branch    Branch @relation(fields: [branchId], references: [id])
  createdBy User   @relation("MemberIndividualCreatedBy", fields: [createdById], references: [id])

  photos MemberIndividualPhoto[]

  @@index([centerId])
  @@index([branchId])
  @@map("member_individuals")
}

// House Hold Visit photos only (one mandatory in-range photo + optional extras).
model MemberIndividualPhoto {
  id                       String   @id @default(cuid())
  memberIndividualId       String
  photoUrl                 String
  photoKey                 String?
  isMandatory              Boolean  @default(false)
  latitude                 Float?
  longitude                Float?
  distanceMeters           Float? // distance from Center.lat/lng at capture time
  distanceFromClientMeters Float? // distance from Client.lat/lng — the FDO's enrollment-time location
  distanceFromBranchMeters Float? // distance from Branch.lat/lng at capture time
  notes                    String?
  uploadedById             String
  createdAt                DateTime @default(now())

  memberIndividual MemberIndividual @relation(fields: [memberIndividualId], references: [id], onDelete: Cascade)
  uploadedBy       User             @relation("MemberIndividualPhotoUploadedBy", fields: [uploadedById], references: [id])

  @@index([memberIndividualId])
  @@map("member_individual_photos")
}

// Center-wide GRT questionnaire fill — BM selects a subset of the center's
// members, picks a questionnaire, answers it once for the group, and uploads
// center-wise photos. A center can have multiple sessions across different
// dates (e.g. re-runs). The disbursement gate is satisfied for a client once
// they belong to at least one COMPLETED session.
model GrtSession {
  id              String    @id @default(cuid())
  sessionId       String    @unique
  centerId        String
  branchId        String
  sessionDate     DateTime
  questionnaireId String
  completedAt     DateTime?
  completedById   String?
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  center        Center        @relation(fields: [centerId], references: [id])
  branch        Branch        @relation(fields: [branchId], references: [id])
  questionnaire Questionnaire @relation(fields: [questionnaireId], references: [id])
  createdBy     User          @relation("GrtSessionCreatedBy", fields: [createdById], references: [id])
  completedBy   User?         @relation("GrtSessionCompletedBy", fields: [completedById], references: [id])

  clients GrtSessionClient[]
  answers GrtSessionAnswer[]
  photos  GrtSessionPhoto[]

  @@index([centerId])
  @@index([branchId])
  @@map("grt_sessions")
}

// Keyed by loanId (not just clientId) — a renewal/new loan for the same client
// needs its own separate GRT coverage; a prior loan's completed session must
// never satisfy the gate for a different loan cycle. clientId is denormalized
// here purely for display convenience.
model GrtSessionClient {
  id           String   @id @default(cuid())
  grtSessionId String
  loanId       String
  clientId     String
  createdAt    DateTime @default(now())

  grtSession GrtSession @relation(fields: [grtSessionId], references: [id], onDelete: Cascade)
  loan       Loan       @relation("LoanGrtSessions", fields: [loanId], references: [id])
  client     Client     @relation("ClientGrtSessions", fields: [clientId], references: [id])

  @@unique([grtSessionId, loanId])
  @@index([grtSessionId])
  @@index([loanId])
  @@map("grt_session_clients")
}

model GrtSessionAnswer {
  id              String   @id @default(cuid())
  grtSessionId    String
  questionId      String
  answerText      String?
  answerBool      Boolean?
  answerChoiceIds String[]
  answeredById    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  grtSession GrtSession @relation(fields: [grtSessionId], references: [id], onDelete: Cascade)
  question   Question   @relation("GrtSessionAnswers", fields: [questionId], references: [id])
  answeredBy User       @relation("GrtSessionAnswerSubmittedBy", fields: [answeredById], references: [id])

  @@unique([grtSessionId, questionId])
  @@index([grtSessionId])
  @@map("grt_session_answers")
}

model GrtSessionPhoto {
  id           String   @id @default(cuid())
  grtSessionId String
  questionId   String? // set only for IMAGE-type questions
  photoUrl     String
  photoKey     String?
  notes        String?
  uploadedById String
  createdAt    DateTime @default(now())

  grtSession GrtSession @relation(fields: [grtSessionId], references: [id], onDelete: Cascade)
  question   Question?  @relation("GrtSessionPhotoQuestion", fields: [questionId], references: [id])
  uploadedBy User       @relation("GrtSessionPhotoUploadedBy", fields: [uploadedById], references: [id])

  @@index([grtSessionId])
  @@map("grt_session_photos")
}

// ================================================================
// ENTERPRISE RBAC + ABAC — New Models
// Added for dynamic role/permission engine
// ================================================================

// ── Module — dynamic feature areas ──────────────────────────────
model Module {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  isSystem    Boolean  @default(false)
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent            Module?            @relation("ModuleHierarchy", fields: [parentId], references: [id])
  children          Module[]           @relation("ModuleHierarchy")
  actions           ModuleAction[]
  permissions       Permission[]
  fieldPermissions  FieldPermission[]
  reportPermissions ReportPermission[]
  approvalWorkflows ApprovalWorkflow[]
  menuItems         MenuItem[]

  @@map("modules")
}

// ── ModuleAction — granular actions per module ───────────────────
model ModuleAction {
  id          String   @id @default(cuid())
  moduleId    String
  name        String
  slug        String
  description String?
  isActive    Boolean  @default(true)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module      Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  permissions Permission[]

  @@unique([moduleId, slug])
  @@index([moduleId])
  @@map("module_actions")
}

// ── Role — dynamic roles, replaces UserRole enum ────────────────
model Role {
  staffLoanSchemes               StaffLoanScheme[]         @relation("StaffLoanSchemeRoles")
  staffLoanApprovalStages        StaffLoanWorkflowStage[]
  staffLoanDisbursementWorkflows StaffLoanWorkflowConfig[] @relation("StaffLoanDisbursementRoles")
  id                             String                    @id @default(cuid())
  name                           String                    @unique
  slug                           String                    @unique
  description                    String?
  color                          String?
  priority                       Int                       @default(0)
  isActive                       Boolean                   @default(true)
  isSystem                       Boolean                   @default(false)
  /// When true, users holding this role can perform the final client-approval
  /// actions (FINAL_APPROVE / FINAL_RETAKE / FINAL_REJECT) alongside ADMIN,
  /// scoped to final approval only — see app/api/approval/clients/[clientId]/action/route.ts
  isSubAdmin                     Boolean                   @default(false)
  parentRoleId                   String?
  /// Role code stored on user.role in DB and JWT.
  /// System roles use their exact value (ADMIN, BRANCH_MANAGER, FDO, AREA_MANAGER).
  /// Custom roles auto-generate from name: multi-word → first letters (e.g. "BVT"),
  /// single-word → full name uppercase (e.g. "PUNE"). Stored as plain String.
  legacyRole                     String                    @default("FDO")
  // Page-level access control: { "/dashboard/branch/create": true, "/dashboard/branch/change": false }
  // null = not configured (sidebar falls back to allowedRoles in navigation.config.ts)
  pagePermissions                Json?
  createdAt                      DateTime                  @default(now())
  updatedAt                      DateTime                  @updatedAt

  parentRole        Role?                @relation("RoleHierarchy", fields: [parentRoleId], references: [id])
  childRoles        Role[]               @relation("RoleHierarchy")
  permissions       RolePermission[]
  userRoles         UserRoleAssignment[]
  fieldPermissions  FieldPermission[]
  reportPermissions ReportPermission[]

  @@map("roles")
}

// ── Permission — module + action combination ─────────────────────
model Permission {
  id          String   @id @default(cuid())
  moduleId    String
  actionId    String
