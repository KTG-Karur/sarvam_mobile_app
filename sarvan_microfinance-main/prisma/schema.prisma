model LoanScheduleCollectionStats {
  id            String @id @default(cuid())
  scheduleId    String @unique
  loanId        String
  installmentNo Int

  // REALIZED (Approved/Posted to GL)
  approvedPrincipalPaid Decimal @default(0) @db.Decimal(15, 2)
  approvedInterestPaid  Decimal @default(0) @db.Decimal(15, 2)
  approvedFeesPaid      Decimal @default(0) @db.Decimal(15, 2)
  approvedPenaltiesPaid Decimal @default(0) @db.Decimal(15, 2)
  approvedTotalPaid     Decimal @default(0) @db.Decimal(15, 2)

  // PENDING (Awaiting Approval in batch)
  pendingPrincipalAmount Decimal @default(0) @db.Decimal(15, 2)
  pendingInterestAmount  Decimal @default(0) @db.Decimal(15, 2)
  pendingFeesAmount      Decimal @default(0) @db.Decimal(15, 2)
  pendingPenaltyAmount   Decimal @default(0) @db.Decimal(15, 2)
  pendingTotalAmount     Decimal @default(0) @db.Decimal(15, 2)

  // TIMESTAMPS & AUDIT
  totalInProcess Decimal   @default(0) @db.Decimal(15, 2)
  lastApprovedAt DateTime?
  lastPendingAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  schedule LoanSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  loan     Loan         @relation("ScheduleStats", fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, installmentNo])
  @@index([loanId])
  @@index([scheduleId])
  @@map("loan_schedule_collection_stats")
}

model LoanTransaction {
  id                       String                @id @default(cuid())
  transactionId            String                @unique
  loanId                   String
  centerId                 String?
  branchId                 String
  clientId                 String
  amount                   Decimal               @db.Decimal(15, 2)
  type                     TransactionType
  paymentMode              PaymentMode           @default(CASH)
  collectedById            String
  postedAt                 DateTime              @default(now())
  transactionDate          DateTime
  description              String?
  batchId                  String?
  remarks                  String?
  principalAmount          Decimal?              @db.Decimal(15, 2)
  interestAmount           Decimal?              @db.Decimal(15, 2)
  feesAmount               Decimal?              @db.Decimal(15, 2)
  penaltyAmount            Decimal?              @db.Decimal(15, 2)
  // Snapshot fields for CCR
  openingArrearsPrincipal  Decimal               @default(0) @db.Decimal(15, 2)
  openingArrearsInterest   Decimal               @default(0) @db.Decimal(15, 2)
  currentDemandPrincipal   Decimal               @default(0) @db.Decimal(15, 2)
  currentDemandInterest    Decimal               @default(0) @db.Decimal(15, 2)
  collectionType           String? // "Demand Collection", "Non Demand Collection"
  isReversed               Boolean               @default(false)
  revertedAt               DateTime?
  revertedById             String?
  revertReason             String?
  revertLatitude  Float? // device/picked location captured when this was reverted (mandatory at the revert UI)
  revertLongitude Float?
  // Set when this transaction's principal+interest is included in an "Allocate for EOD"
  // GL posting (accounting-posting.service.ts's postEodCollectionAllocation). Lets the
  // EOD allocation tab track pending/allocated per-transaction instead of only per funder/date.
  eodAllocatedAt           DateTime?
  // True for backup/migrated loan transactions (uploan import, ongoing-loan backup) whose
  // balance-effect (Loan/Client aggregates) is real but whose cash was never collected
  // through this system — must never be swept into an "Allocate for EOD" GL cash-receipt
  // voucher. Deliberately separate from eodAllocatedAt: that field also feeds a
  // legacy-residual netting calculation in accounting-posting.service.ts, so stamping it
  // directly on migrated rows (with no real GL voucher behind them) would corrupt that
  // netting for any other transaction sharing the same branch/date marker.
  excludeFromEodAllocation Boolean               @default(false)
  // GL Sync tracking fields
  isGlSynced               Boolean               @default(false)
  glSyncedAt               DateTime?
  glSyncBatchId            String?
  status                   TransactionStatus     @default(PENDING)
  approvedById             String?
  approvedAt               DateTime?
  rejectionReason          String?
  collectionBatchId        String? // Groups transactions from one center meeting
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  branch                   Branch                @relation(fields: [branchId], references: [id])
  center                   Center?               @relation(fields: [centerId], references: [id])
  client                   Client                @relation(fields: [clientId], references: [id])
  collectedBy              User                  @relation("CollectedTransactions", fields: [collectedById], references: [id])
  approvedBy               User?                 @relation("ApprovedTransactions", fields: [approvedById], references: [id])
  revertedBy               User?                 @relation("RevertedTransactions", fields: [revertedById], references: [id])
  loan                     Loan                  @relation(fields: [loanId], references: [id])
  lines                    LoanTransactionLine[]
  foreclosureRequest       ForeclosureRequest?

  @@index([loanId])
  @@index([transactionDate])
  @@index([isGlSynced])
  @@map("loan_transactions")
}

