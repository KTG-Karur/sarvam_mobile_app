  client     Client @relation(fields: [clientId], references: [id])
  closedBy   User   @relation("LoanClosureRecordClosedBy", fields: [closedById], references: [id])
  revertedBy User?  @relation("LoanClosureRecordRevertedBy", fields: [revertedById], references: [id])

  @@index([loanId])
  @@index([clientId])
  @@index([closedById])
  @@map("loan_closure_records")
}

// ── HighmarkReport — CRIF (SurepassCrif) credit bureau pull ──────────
// One row per pull; a client's report history is simply every row for
// its clientId/aadhaarHash ordered by pulledAt — no separate history table.
model HighmarkReport {
  id                String  @id @default(cuid())
  pullId            Int
  provider          String  @default("SurepassCrif")
  status            String
  fromCache         Boolean @default(false)
  providerReference String?
  creditScore       Int?
  creditsCharged    Decimal @db.Decimal(10, 2)
  reportJson        Json

  firstName     String
  lastName      String?
  aadhaarHash   String
  aadhaarMasked String
  phone         String

  consentObtained Boolean  @default(false)
  consentAt       DateTime

  requestedById String
  requestedBy   User   @relation("HighmarkReportsRequested", fields: [requestedById], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  // Never deleted when a client/draft is removed — onDelete: SetNull is explicit here
  // (rather than left to Prisma's implicit default) so the Highmark Log audit trail can
  // never be lost to a future onDelete: Cascade regression on this relation.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  pulledAt  DateTime
  createdAt DateTime @default(now())

  @@unique([pullId, provider])
  @@index([aadhaarHash])
  @@index([clientId, pulledAt])
  @@index([branchId, pulledAt])
  @@map("highmark_reports")
}

// ── HighmarkConfig — Admin-controlled Highmark (CRIF) pull policy (singleton row) ──
model HighmarkConfig {
  id                  String   @id @default(cuid())
  pullLimitPerAadhaar Int      @default(3)
  limitWindowDays     Int      @default(180)
  freshnessWindowDays Int      @default(60)
  enforcementMode     String   @default("BLOCK") // BLOCK | WARN
  limitedRoles        String[] @default(["BRANCH_MANAGER", "FDO"])
  updatedAt           DateTime @updatedAt

  @@map("highmark_config")
}

// ── ReportRequest — async "Request Report" export queue ─────────
model ReportRequest {
  id        String @id @default(cuid())
  requestId String @unique // 6-digit sequential display ID, e.g. "000042"

  reportSlug String // key into app/lib/reports/report-registry.ts
  reportName String // denormalized display name at request time

  branchIds   String[] // [] = ALL branches; else Branch cuids
  branchLabel String // "ALL" | "<Branch Name>" | "N Branches" — precomputed for display

  fromDate DateTime? @db.Date
  toDate   DateTime? @db.Date

  /// Extra per-report filters beyond date/branch (centerId, product, status, etc.) —
  /// shape is report-specific, see ReportFetchParams.extra in app/lib/reports/report-registry.ts.
  /// Included in the same-day duplicate-request match key so two exports that only
  /// differ by e.g. center are never treated as the same request.
  filters Json?

  fileFormat ReportExportFormat

  status          ReportRequestStatus @default(PENDING)
  progressPercent Int                 @default(0)
  totalCount      Int                 @default(0)

  storageKey   String?
  errorMessage String?
  attemptCount Int       @default(0)
  lockedAt     DateTime?

  requestedAt DateTime  @default(now())
  completedAt DateTime?
  cancelledAt DateTime?

  requestedByUserId   String
  cancelledByUserId   String?
  requestedByBranchId String?

  requestedByUser User  @relation("ReportRequestRequestedBy", fields: [requestedByUserId], references: [id])
  cancelledByUser User? @relation("ReportRequestCancelledBy", fields: [cancelledByUserId], references: [id])

  @@index([status, requestedAt])
  @@index([requestedByUserId])
  @@map("report_requests")
}

enum ReportRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ReportExportFormat {
  EXCEL
  PDF
  CSV
  WORD
}

// ── UploanImportJob — background job for the Member Upload (uploan) bulk import ──
// One job per "Import" click on /dashboard/masters/uploan/member; processed by
// app/lib/services/uploan-import-worker.ts (same in-process polling-worker shape as
// ReportRequest above) since a full branch import (600+ members, each replaying up to
// ~60 historical transactions) cannot complete inside a single request.
model UploanImportJob {
  id             String                @id @default(cuid())
  branchId       String
  branch         Branch                @relation(fields: [branchId], references: [id])
  status         UploanImportJobStatus @default(PENDING)
  totalRows      Int                   @default(0)
  /// GCS object key of the uploaded Branch Wise Repayment xlsx — the worker re-downloads
  /// and re-parses it once per job (cached in memory for the job's duration) rather than
  /// persisting the parsed rows in Postgres.
  historyFileKey String
  errorMessage   String?
  lockedAt       DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  createdById String
  createdBy   User   @relation("UploanImportJobCreatedBy", fields: [createdById], references: [id])

  // Same-day revert audit trail — mirrors the who/when/why already recorded on every
  // other revert action in this app (e.g. LoanTransaction.revertedAt/revertedById/revertReason).
  revertReason String?
  revertedAt   DateTime?
  revertedById String?
  revertedBy   User?     @relation("UploanImportJobRevertedBy", fields: [revertedById], references: [id])

  rows UploanImportJobRow[]

  @@index([status, createdAt])
  @@map("uploan_import_jobs")
}

enum UploanImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  // A same-day revert of this job's rows has been kicked off / has finished — see
  // UploanImportJobRowStatus.REVERT_PENDING and app/lib/services/uploan-import-row.service.ts's
  // revertSingleUploanRow().
  REVERTING
  REVERTED
}

/// One row per member being migrated in a UploanImportJob — mirrors GrtSessionClient's
/// child-row-per-item shape rather than a single bulk Json array on the parent.
model UploanImportJobRow {
  id       String          @id @default(cuid())
  jobId    String
  job      UploanImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rowIndex Int

  /// The server-validated row (name, mobile, resolved center/group/product/funder ids,
  /// etc.) — same shape as ValidatedUploanRow, everything importSingleUploanRow() needs.
  rowData Json

  status        UploanImportJobRowStatus @default(PENDING)
  clientId      String?
  loanNumber    String?
  // Populated alongside clientId/loanNumber when status becomes CREATED — lets
  // revertSingleUploanRow() target exactly what this row created without having to
  // re-derive it (loanNumber alone isn't a reliable FK; CoApplicant has no other way
  // to be traced back to the row that created it).
  loanId        String?
  coApplicantId String?
  errorMessage  String?
  lockedAt      DateTime?
  createdAt     DateTime                 @default(now())
  processedAt   DateTime?

  // Per-member revert audit — a single member can be reverted on its own from the
  // Import History page (POST .../import/[jobId]/rows/[rowId]/revert) without reverting
  // the whole job; the job stays COMPLETED so its other members remain revertable.
  // Mirrors the job-level revertReason/revertedAt/revertedById on UploanImportJob.
  revertReason String?
  revertedAt   DateTime?
  revertedById String?

  @@index([jobId, status])
  @@index([status, createdAt])
  @@map("uploan_import_job_rows")
}

enum UploanImportJobRowStatus {
  PENDING
  PROCESSING
  CREATED
  FAILED
  // Revert flow (same-day only) — see uploan-import-revert-gate.ts and
  // revertSingleUploanRow() in uploan-import-row.service.ts.
  REVERT_PENDING
  PROCESSING_REVERT
  REVERTED
  REVERT_FAILED
}

// ── Single Device Login & Access Control ──
enum DeviceAccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model DeviceAccessRequest {
  id              String                    @id @default(cuid())
  userId          String
  employeeId      String
  deviceId        String
  deviceName      String?
  status          DeviceAccessRequestStatus @default(PENDING)
  rejectionReason String?
  reviewedById    String?
  requestedAt     DateTime                  @default(now())
  reviewedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  user       User  @relation("DeviceAccessRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("DeviceAccessRequestReviewer", fields: [reviewedById], references: [id])

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([employeeId])
  @@map("device_access_requests")
}

model DeviceLoginHistory {
  id                  String    @id @default(cuid())
  userId              String
  employeeId          String
  deviceId            String
  deviceName          String?
  loginAt             DateTime  @default(now())
  logoutAt            DateTime?
  adminApprovalStatus String?
  ipAddress           String?
  createdAt           DateTime  @default(now())

  user User @relation("DeviceLoginHistoryUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loginAt])
  @@index([employeeId])
  @@map("device_login_histories")
}

enum LoginPlatform {
  WEB
  MOBILE
}

/// One row per user per IST calendar day per platform — powers the User Login
/// Activity report (Reports → Others). Written on every login AND (throttled) on
/// every authenticated API request: web tokens last 72h and mobile tokens never
/// expire, so login events alone would miss most real daily usage.
/// Writer: app/lib/services/user-activity-tracker.ts
model UserLoginActivity {
  id           String        @id @default(cuid())
  userId       String
  activityDate DateTime      @db.Date // IST calendar day
  platform     LoginPlatform
  branchId     String? // active branch at last activity
  loginCount   Int           @default(0)
  firstSeenAt  DateTime      @default(now())
  lastSeenAt   DateTime      @default(now())
  lastLoginAt  DateTime?
  ipAddress    String?
  deviceName   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activityDate, platform])
  @@index([activityDate, platform])
  @@map("user_login_activities")
}

/// Authenticated API requests per minute and platform — capacity-planning data for the
/// User Login Activity report ("Current (Live)"). Counted in memory, flushed every ~30s.
/// Writer: app/lib/services/api-traffic-tracker.ts
model ApiTrafficMinute {
  id       String        @id @default(cuid())
  bucket   DateTime // start of the UTC minute
  platform LoginPlatform
  requests Int           @default(0)

  @@unique([bucket, platform])
  @@index([bucket])
  @@map("api_traffic_minutes")
}

/// Authenticated API requests per IST day, endpoint (ids collapsed to :id) and platform.
model ApiTrafficEndpointDay {
  id       String        @id @default(cuid())
  day      DateTime      @db.Date
  path     String
  platform LoginPlatform
  requests Int           @default(0)

  @@unique([day, path, platform])
  @@index([day])
  @@map("api_traffic_endpoint_days")
}

// ── ClosedMemberImportJob — background job for the "Closed Loan Member Upload" bulk
// import (/dashboard/masters/uploan/closed-member). Sibling to UploanImportJob above but
// for legacy members whose loan is ALREADY closed — no repayment history to replay, only
// unreturned Savings/Gold to migrate as pending SavingsRefundRequest/GoldTransaction(GIVE)
// requests. Reuses UploanImportJobStatus/UploanImportJobRowStatus (identical semantics) so
// no separate enums are needed. Processed by
// app/lib/services/closed-member-import-worker.ts, its own poller (not merged into
// uploan-import-worker.ts — that worker's DB calls are hardcoded to the uploan tables).
model ClosedMemberImportJob {
  id            String                @id @default(cuid())
  branchId      String
  branch        Branch                @relation(fields: [branchId], references: [id])
  status        UploanImportJobStatus @default(PENDING)
  /// The one global toggle from Step 1 of the upload UI — whether each row gets a full
  /// historical Loan (schedule + one aggregate migrated transaction, then closed) or a
  /// bare closed-Loan shell that exists only to anchor the Savings/Gold requests.
  createLoan    Boolean
  totalRows     Int                   @default(0)
  /// GCS object key of the optional Loan-Advance Outstanding Report, if uploaded.
  thriftFileKey String?
  /// GCS object key of the optional Gold Loan Details file, if uploaded.
  goldFileKey   String?
  errorMessage  String?
  lockedAt      DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  createdById String
  createdBy   User   @relation("ClosedMemberImportJobCreatedBy", fields: [createdById], references: [id])

  revertReason String?
  revertedAt   DateTime?
  revertedById String?
  revertedBy   User?     @relation("ClosedMemberImportJobRevertedBy", fields: [revertedById], references: [id])

  rows ClosedMemberImportJobRow[]

  @@index([status, createdAt])
  @@map("closed_member_import_jobs")
}

/// One row per member being migrated in a ClosedMemberImportJob — same shape/purpose as
/// UploanImportJobRow.
model ClosedMemberImportJobRow {
  id       String                @id @default(cuid())
  jobId    String
  job      ClosedMemberImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rowIndex Int

  /// The server-validated row — same shape as ValidatedClosedMemberRow, everything
  /// importSingleClosedMemberRow() needs.
  rowData Json

  status                 UploanImportJobRowStatus @default(PENDING)
  clientId               String?
  loanNumber             String?
  loanId                 String?
  coApplicantId          String?
  /// Populated when a SavingsRefundRequest/GoldTransaction(GIVE) was auto-created for this
  /// row — lets revertSingleClosedMemberRow() and the revert-gate target/inspect them
  /// without re-deriving from loanId.
  savingsRefundRequestId String?
  goldTransactionId      String?
  errorMessage           String?
  lockedAt               DateTime?
  createdAt              DateTime                 @default(now())
  processedAt            DateTime?

  // Per-member revert audit — same as UploanImportJobRow: one member can be reverted
  // on its own without reverting the whole job (job stays COMPLETED).
  revertReason String?
  revertedAt   DateTime?
  revertedById String?

  @@index([jobId, status])
  @@index([status, createdAt])
  @@map("closed_member_import_job_rows")
}

// Staff loans are employee-owned and independent of customer lending.
// Scheme terms are snapshotted on submission. Published workflow versions and
// their stages must be retained while referenced by an application.
enum StaffLoanInterestType {
  INTEREST_FREE
  FLAT
  MONTHLY
}

enum StaffLoanAmountBasis {
  FIXED_AMOUNT
  SALARY_MULTIPLE
}

enum StaffLoanRecoveryMethod {
  SALARY
  CASH_BANK
}

enum StaffLoanStatus {
  DRAFT
  SUBMITTED
  RETURNED
  APPROVED
  REJECTED
  CANCELLED
  ACTIVE
  CLOSED
}

enum StaffLoanDecisionAction {
  SUBMIT
  APPROVE
  REJECT
  RETURN
  RESUBMIT
  CANCEL
  /// An approver edited the loan terms before final approval.
  EDIT
}

enum StaffLoanTransactionType {
  DISBURSEMENT
  SALARY_RECOVERY
  CASH_BANK_RECOVERY
  EARLY_SETTLEMENT
  FINAL_SETTLEMENT_RECOVERY
  REVERSAL
}

enum StaffLoanTransactionStatus {
  PENDING
  POSTED
  REJECTED
}

model StaffLoanScheme {
  id                    String                @id @default(cuid())
  code                  String                @unique
  name                  String
  description           String?
  minimumServiceMonths  Int
  /// Minimum gross monthly salary (EARNINGS components) required to be eligible; 0 = no minimum.
  minimumSalaryPerMonth Decimal               @default(0) @db.Decimal(15, 2)
  amountBasis           StaffLoanAmountBasis
  maximumAmount         Decimal?              @db.Decimal(15, 2)
  salaryMultiplier      Decimal?              @db.Decimal(10, 4)
  maximumTenureMonths   Int
  maximumActiveLoans    Int
  interestType          StaffLoanInterestType
  /// Annual percentage for FLAT, monthly percentage for MONTHLY; must be zero for INTEREST_FREE.
  annualInterestRate    Decimal               @db.Decimal(7, 4)
  isActive              Boolean               @default(false)
  version               Int                   @default(1)
  createdById           String
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  createdBy             User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  applicableBranches    Branch[]          @relation("StaffLoanSchemeBranches")
  applicableDepartments Department[]      @relation("StaffLoanSchemeDepartments")
  applicableRoles       Role[]            @relation("StaffLoanSchemeRoles")
  salaryBasisComponents SalaryComponent[] @relation("StaffLoanSalaryBasis")
  loans                 StaffLoan[]

  @@index([isActive])
  @@map("staff_loan_schemes")
}

/// Which module a workflow configuration drives. Loan and Advance keep separate, independently versioned
/// configurations (stages, salary date, active flag) on the same master page.
enum StaffWorkflowKind {
  LOAN
  ADVANCE
}

model StaffLoanWorkflowConfig {
  id          String            @id @default(cuid())
  kind        StaffWorkflowKind @default(LOAN)
  name        String
  isActive    Boolean           @default(false)
  /// Day of the month salaries are paid (1-31). Staff loan installments fall due on this day (the day
  /// before when it is a Sunday). Null only on configs saved before this setting existed.
  salaryDay   Int?
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  createdBy         User                     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  stages            StaffLoanWorkflowStage[]
  disbursementRoles Role[]                   @relation("StaffLoanDisbursementRoles")
  loans             StaffLoan[]
  advances          StaffAdvance[]

  @@index([kind, createdAt])
  @@map("staff_loan_workflow_configs")
}

model StaffLoanWorkflowStage {
  id         String   @id @default(cuid())
  configId   String
  levelOrder Int
  stageName  String
  roleId     String
  createdAt  DateTime @default(now())

  config StaffLoanWorkflowConfig @relation(fields: [configId], references: [id], onDelete: Restrict)
  role   Role                    @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([configId, levelOrder])
  @@index([roleId])
  @@map("staff_loan_workflow_stages")
}

model StaffLoan {
  id                       String                  @id @default(cuid())
  loanNumber               String                  @unique
  employeeId               String
  /// Owning branch is historical; employee transfers do not rewrite ownership.
  branchId                 String
  schemeId                 String
  schemeVersion            Int
  schemeSnapshot           Json
  workflowConfigId         String?
  /// References levelOrder in the retained workflow version; null outside review.
  currentApprovalLevel     Int?
  status                   StaffLoanStatus         @default(DRAFT)
  purpose                  String
  remarks                  String?
  requestedAmount          Decimal                 @db.Decimal(15, 2)
  approvedAmount           Decimal?                @db.Decimal(15, 2)
  tenureMonths             Int
  interestType             StaffLoanInterestType
  annualInterestRate       Decimal                 @db.Decimal(7, 4)
  recoveryMethod           StaffLoanRecoveryMethod
  eligibilitySnapshot      Json?
  /// Supporting document (image or PDF) uploaded with the application; storage object key, not a URL.
  documentKey              String?
  documentName             String?
  documentMimeType         String?
  documentSize             Int?
  proposedDisbursementDate DateTime?               @db.Date
  firstDueDate             DateTime?               @db.Date
  submittedAt              DateTime?
  approvedAt               DateTime?
  disbursedAt              DateTime?
  closedAt                 DateTime?
  /// Outstanding exit balances remain open pending an explicit manual decision.
  exitReviewRequired       Boolean                 @default(false)
  /// Optimistic concurrency token for state transitions and repayment posting.
  version                  Int                     @default(1)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  employee       User                     @relation("StaffLoanEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  branch         Branch                   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  scheme         StaffLoanScheme          @relation(fields: [schemeId], references: [id], onDelete: Restrict)
  workflowConfig StaffLoanWorkflowConfig? @relation(fields: [workflowConfigId], references: [id], onDelete: Restrict)
  decisions      StaffLoanDecision[]
  schedules      StaffLoanSchedule[]
  transactions   StaffLoanTransaction[]

  @@index([employeeId, status])
  @@index([branchId, status, createdAt])
  @@index([schemeId, status])
  @@index([workflowConfigId, currentApprovalLevel, status])
  @@map("staff_loans")
}

model StaffLoanDecision {
  id         String                  @id @default(cuid())
  loanId     String
  action     StaffLoanDecisionAction
  stageOrder Int?
  stageName  String?
  actedById  String
  remarks    String?
  createdAt  DateTime                @default(now())

  loan    StaffLoan @relation(fields: [loanId], references: [id], onDelete: Restrict)
  actedBy User      @relation(fields: [actedById], references: [id], onDelete: Restrict)

  @@index([loanId, createdAt])
  @@index([actedById])
  @@map("staff_loan_decisions")
}

model StaffLoanSchedule {
  id            String   @id @default(cuid())
  loanId        String
  installmentNo Int
  dueDate       DateTime @db.Date
  principalDue  Decimal  @db.Decimal(15, 2)
  interestDue   Decimal  @db.Decimal(15, 2)
  /// Interest of this installment that an early settlement waived (it was not yet due). Not a payment, so it never
  /// counts as paid; it is simply no longer owed. 0 for every installment that was not waived.
  interestWaived Decimal @default(0) @db.Decimal(15, 2)
  createdAt     DateTime @default(now())

  // Paid/partial/overdue and outstanding are derived from posted allocations,
  // reversals, and business date rather than an independently mutable balance.
  loan        StaffLoan                      @relation(fields: [loanId], references: [id], onDelete: Restrict)
  allocations StaffLoanRepaymentAllocation[]

  @@unique([loanId, installmentNo])
  @@unique([id, loanId])
  @@index([dueDate])
  @@map("staff_loan_schedules")
}

model StaffLoanTransaction {
  id                String                     @id @default(cuid())
  loanId            String
  type              StaffLoanTransactionType
  status            StaffLoanTransactionStatus @default(PENDING)
  transactionDate   DateTime                   @db.Date
  amount            Decimal                    @db.Decimal(15, 2)
  paymentMode       PaymentMode?
  reference         String?
  remarks           String?
  /// Stable operation key; retries must return the original operation.
  idempotencyKey    String                     @unique
  /// Link to the salary header, whose identity survives replacement of line items.
  salaryPayRecordId String?
  /// Reversals are explicit records, never deletion of an earlier recovery.
  reversalOfId      String?                    @unique
  createdById       String
  createdAt         DateTime                   @default(now())
  postedAt          DateTime?

  loan            StaffLoan                      @relation(fields: [loanId], references: [id], onDelete: Restrict)
  salaryPayRecord SalaryPayRecord?               @relation(fields: [salaryPayRecordId], references: [id], onDelete: Restrict)
  createdBy       User                           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  reversalOf      StaffLoanTransaction?          @relation("StaffLoanTransactionReversal", fields: [reversalOfId, loanId], references: [id, loanId], onDelete: Restrict, onUpdate: Restrict)
  reversal        StaffLoanTransaction?          @relation("StaffLoanTransactionReversal")
  vouchers        StaffLoanVoucher[]
  allocations     StaffLoanRepaymentAllocation[]

  @@unique([id, loanId])
  @@unique([reversalOfId, loanId])
  @@index([loanId, transactionDate])
  @@index([salaryPayRecordId])
  @@index([status, transactionDate])
  @@map("staff_loan_transactions")
}

model StaffLoanRepaymentAllocation {
  id            String   @id @default(cuid())
  loanId        String
  transactionId String
  scheduleId    String
  principal     Decimal  @db.Decimal(15, 2)
  interest      Decimal  @db.Decimal(15, 2)
  createdAt     DateTime @default(now())

  // Composite foreign keys prevent allocating one loan's payment to another.
  transaction StaffLoanTransaction @relation(fields: [transactionId, loanId], references: [id, loanId], onDelete: Restrict, onUpdate: Restrict)
  schedule    StaffLoanSchedule    @relation(fields: [scheduleId, loanId], references: [id, loanId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([transactionId, scheduleId])
  @@index([scheduleId, loanId])
  @@map("staff_loan_repayment_allocations")
}

/// Preserve the audit link even if someone attempts to delete a linked voucher.
model StaffLoanVoucher {
  transactionId          String
  financialTransactionId String

  transaction          StaffLoanTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  financialTransaction FinancialTransaction @relation(fields: [financialTransactionId], references: [id], onDelete: Restrict)

  @@id([transactionId, financialTransactionId])
  @@index([financialTransactionId])
  @@map("staff_loan_vouchers")
}

// ─── Staff Advance ────────────────────────────────────────────────────────────
// Interest-free salary advance repaid in exactly two monthly installments. Business data is kept apart
// from Staff Loan; only the approval stages/roles (StaffLoanWorkflowConfig) and the employee/branch/RBAC
// patterns are shared.

enum StaffAdvanceStatus {
  SUBMITTED
  /// Fully approved, waiting for a disbursement-authority holder to pay it out.
  APPROVED
  ACTIVE
  COMPLETED
  REJECTED
  CANCELLED
}

enum StaffAdvanceDecisionAction {
  SUBMIT
  EDIT
  APPROVE
  REJECT
  CANCEL
  DISBURSE
  REPAYMENT
  COMPLETE
}

enum StaffAdvanceTransactionStatus {
  PENDING
  POSTED
}

model StaffAdvance {
  id                   String             @id @default(cuid())
  /// Business number SA-000001; `id` stays the internal key.
  advanceNumber        String             @unique
  employeeId           String
  /// Owning branch is historical; employee transfers do not rewrite ownership.
  branchId             String
  status               StaffAdvanceStatus @default(SUBMITTED)
  /// Advance amount. Interest-free, so this is also the total repayable.
  amount               Decimal            @db.Decimal(15, 2)
  /// 1 or 2, chosen on the application (enforced by a CHECK constraint).
  repaymentMonths      Int                @default(2)
  purpose              String
  remarks              String?
  /// Supporting document (image or PDF), same handling as the Staff Loan one; storage object key, not a URL.
  /// Null only for advances applied before the document became mandatory.
  documentKey          String?
  documentName         String?
  documentMimeType     String?
  documentSize         Int?
  workflowConfigId     String?
  /// References levelOrder in the retained workflow version; null outside review.
  currentApprovalLevel Int?
  /// Salary picture (current / projected in-hand) captured when applied or last edited.
  salarySnapshot       Json?
  submittedAt          DateTime?
  approvedAt           DateTime?
  /// Set when the approved advance is paid out; the two installments are created at that moment.
  disbursedAt          DateTime?
  paymentMode          PaymentMode?
  /// UTR / transaction reference (mandatory for a bank transfer).
  paymentReference     String?
  completedAt          DateTime?
  /// Optimistic concurrency token for state transitions.
  version              Int                @default(1)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  employee       User                      @relation("StaffAdvanceEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  branch         Branch                    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  workflowConfig StaffLoanWorkflowConfig?  @relation(fields: [workflowConfigId], references: [id], onDelete: Restrict)
  decisions      StaffAdvanceDecision[]
  schedules      StaffAdvanceSchedule[]
  transactions   StaffAdvanceTransaction[]

  @@index([employeeId, status])
  @@index([branchId, status, createdAt])
  @@index([workflowConfigId, currentApprovalLevel, status])
  @@map("staff_advances")
}

model StaffAdvanceDecision {
  id         String                     @id @default(cuid())
  advanceId  String
  action     StaffAdvanceDecisionAction
  stageOrder Int?
  stageName  String?
  actedById  String
  remarks    String?
  /// Field-level audit for EDIT: { field: { from, to } }.
  changes    Json?
  createdAt  DateTime                   @default(now())

  advance StaffAdvance @relation(fields: [advanceId], references: [id], onDelete: Restrict)
  actedBy User         @relation(fields: [actedById], references: [id], onDelete: Restrict)

  @@index([advanceId, createdAt])
  @@index([actedById])
  @@map("staff_advance_decisions")
}

model StaffAdvanceSchedule {
  id            String   @id @default(cuid())
  advanceId     String
  /// 1 or 2 only (CHECK constraint): no third installment can exist.
  installmentNo Int
  dueDate       DateTime @db.Date
  amountDue     Decimal  @db.Decimal(15, 2)
  createdAt     DateTime @default(now())

  advance     StaffAdvance                      @relation(fields: [advanceId], references: [id], onDelete: Restrict)
  allocations StaffAdvanceRepaymentAllocation[]

  @@unique([advanceId, installmentNo])
  @@unique([id, advanceId])
  @@index([dueDate])
  @@map("staff_advance_schedules")
}

model StaffAdvanceTransaction {
  id                String                        @id @default(cuid())
  advanceId         String
  status            StaffAdvanceTransactionStatus @default(PENDING)
  /// First day of the payroll month the deduction belongs to.
  transactionDate   DateTime                      @db.Date
  amount            Decimal                       @db.Decimal(15, 2)
  remarks           String?
  /// Stable operation key; a retry can never post the same deduction twice.
  idempotencyKey    String                        @unique
  /// The payroll record that deducted it. Null for an early settlement, which is paid directly instead.
  salaryPayRecordId String?
  /// Set only on an early settlement (Cash / Bank Transfer); a salary deduction has no payment mode.
  paymentMode       PaymentMode?
  /// UTR / transaction reference of an early settlement paid by bank transfer.
  reference         String?
  createdById       String
  createdAt         DateTime                      @default(now())
  postedAt          DateTime?

  advance         StaffAdvance                      @relation(fields: [advanceId], references: [id], onDelete: Restrict)
  salaryPayRecord SalaryPayRecord?                  @relation(fields: [salaryPayRecordId], references: [id], onDelete: Restrict)
  createdBy       User                              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  allocations     StaffAdvanceRepaymentAllocation[]

  @@unique([id, advanceId])
  @@index([advanceId, transactionDate])
  @@index([salaryPayRecordId])
  @@map("staff_advance_transactions")
}

model StaffAdvanceRepaymentAllocation {
  id            String   @id @default(cuid())
  advanceId     String
  transactionId String
  scheduleId    String
  amount        Decimal  @db.Decimal(15, 2)
  createdAt     DateTime @default(now())

  // Composite foreign keys prevent allocating one advance's deduction to another's installment.
  transaction StaffAdvanceTransaction @relation(fields: [transactionId, advanceId], references: [id, advanceId], onDelete: Restrict, onUpdate: Restrict)
  schedule    StaffAdvanceSchedule    @relation(fields: [scheduleId, advanceId], references: [id, advanceId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([transactionId, scheduleId])
  @@index([scheduleId, advanceId])
  @@map("staff_advance_repayment_allocations")
}

/// Audit trail of every Punch Radius lock / unlock (HR → Attendance → Punch Radius).
model PunchRadiusLog {
  id          String   @id @default(cuid())
  employeeId  String
  employee    User     @relation("PunchRadiusLogEmployee", fields: [employeeId], references: [id])
  locked      Boolean
  changedById String
  changedBy   User     @relation("PunchRadiusLogChangedBy", fields: [changedById], references: [id])
  createdAt   DateTime @default(now())

  @@index([employeeId, createdAt])
  @@map("punch_radius_logs")
}
